<Application x:Class="Wpf_Traffic_violation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wpf_Traffic_violation"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri=" MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/Icon/Icons.xaml"/>
                <ResourceDictionary Source="Assets/Themes/LightTheme.xaml"/>
                <!--<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />-->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.blue.xaml"/>
                <!--<ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.lightblue.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="AutoId">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding  Search}"/>
                </StackPanel>
            </DataTemplate>
       
            <!--#region ButtonStyle -->
       
            <Style TargetType="Button" x:Key="sub1" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="#BCBEC0"/>
                <Setter Property="Background" Value="#E6E7E8"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Width" Value="131"/>
                <!--<Setter Property="Focusable" Value="True"/>-->

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                              CornerRadius="5 5 1 1"
                              BorderThickness="1,1,1,0"
                              Padding="5"
                              BorderBrush="Gray" >
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">

                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="true" >

                        <Setter Property="Foreground" Value="#022551"></Setter>
                    </Trigger>

                </Style.Triggers>
            </Style>
            <!--////////////////////////////////////////////////////////////////////////////////////////////-->
            <Style TargetType="Button" x:Key="Repotr_Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="Gray" />
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Tajawal "/>
                <Setter Property="Margin" Value="10 0 10 10"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="true" >

                        <Setter Property="Foreground" Value="#022551"></Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!--////////////////////////////////////////////////////////////////////////////////////////////-->
            <Style TargetType="Button" x:Key="sub_but_From" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="DarkBlue"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Width" Value="131"/>
                <!--<Setter Property="Focusable" Value="True"/>-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                              CornerRadius="1 1 1 1"
                              BorderThickness="1,1,1,0"
                              Padding="1"
                              BorderBrush="#cfd8dc">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">

                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="true" >

                        <Setter Property="Foreground" Value="DarkBlue"></Setter>
                        <Setter Property="Background" Value="White"/>
                    </Trigger>

                </Style.Triggers>
            </Style>

            <!--style Button items home-->
            <Style TargetType="Button" x:Key="btnItemHome" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#fff"/>
                <Setter Property="Foreground" Value="#9FA8DA"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="Margin" Value="5"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                              CornerRadius="6"
                              BorderThickness="1"
                              Padding="5"
                              BorderBrush="#9FA8DA"
                                    >
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">

                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3D5AFE"/>
                        <Setter Property="Foreground" Value="#fff"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"></ScaleTransform>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!--//////////////////////////////////////////////////////////////////////////////////////////////////////////-->
            <!--style btnItemStatistical-->
            <Style TargetType="Button" x:Key="btnItemStatistical" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#9FA8DA"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                              CornerRadius="2"
                              BorderThickness="1"
                              Padding="5"
                              BorderBrush="#3D5AFE">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">

                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3D5AFE"/>
                        <Setter Property="Foreground" Value="#fff"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"></ScaleTransform>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!--/////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
            <!--style subButton-->
            <Style TargetType="Button" x:Key="subButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="#03719C" />
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Tajawal "/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Height" Value="56"/>
                <Setter Property="Width" Value="115"/>
                <Setter Property="FontWeight" Value="Bold"/>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="true" >

                        <Setter Property="Foreground" Value="#022551"></Setter>


                    </Trigger>
                </Style.Triggers>
            </Style>
            <!--/////////////////////////////////////////////////////////////////////////////////////////////////////////////-->
            <!--#endregion-->

            <!--#region DataGridStyle -->
            <!--style Style_Datagrid-->

            <Style TargetType="DataGrid" x:Key="Style_Datagrid">
                <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="15 5 5 5"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowHeight" Value="40"/>
                <Setter Property="CanUserSortColumns" Value="false"/>
                <!--<Setter Property="RowBackground" Value="Lavender"/>-->
                <Setter Property="Background" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="LightBlue"/>
                <!--<Setter Property="GridLinesVisibility" Value="All"/>-->
                <Setter Property="ColumnHeaderHeight" Value="70"/>
                <!--<Setter Property="Foreground" Value="Brown"/>-->
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <!--<Setter Property="CanUserReorderColumns" Value="False"/>-->
                <!--<Setter Property="HorizontalAlignment" Value="Right"/>-->
                <Setter Property="BorderBrush" Value="DarkGray"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <!--<Setter Property="VerticalAlignment" Value="Center"/>-->
                <!--<Setter Property="ScrollViewer.CanContentScroll" Value="True"/>-->
                <!--<Setter Property="RowDetailsVisibilityMode" Value="VisibleWhenSelected" />-->
                <!--<Setter Property="ScrollViewer.CanContentScroll" Value="False" />-->
                <Setter Property="FontFamily" Value="Tajawal"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
                <!--<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>-->
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="ColumnHeaderStyle" Value="{DynamicResource StylecolumnHeder}"/>
            </Style>
            <!--DataGridColumnHeader Style-->
            <Style TargetType="{x:Type DataGridColumnHeader}" x:Key="StylecolumnHeder">
                <Setter Property="Background" Value="Black"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Tajawal"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="10,0,0,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                            <Grid>
                                <Border  BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         Background="{TemplateBinding BorderBrush}"
                                         Padding="{TemplateBinding Padding}">

                                    <Grid Margin="{TemplateBinding Padding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          RecognizesAccessKey="True"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                        <StackPanel 
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="5,0,0,0">
                                            <Path x:Name="SortUpIcon"
                                              Data="{DynamicResource SortUp}"
                                              Height="{TemplateBinding FontSize}"
                                              Fill="{DynamicResource DataGrid.Column.Header.Icon.Static}" Stretch="Uniform" Width="10"/>

                                            <Path x:Name="SortDownIcon"
                                              Data="{DynamicResource SortDown}"
                                              Height="{TemplateBinding FontSize}"
                                              Fill="{DynamicResource DataGrid.Column.Header.Icon.Static}" Stretch="Uniform" Width="10"/>
                                        </StackPanel>

                                    </Grid>

                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="SortDownIcon"
                                             Property="Fill"
                                             Value="{DynamicResource Sort.Up.Icon.Active}"
                                            />

                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="SortUpIcon"
                                             Property="Fill"
                                             Value="{DynamicResource Sort.Up.Icon.Active}"/>

                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type DataGridCell}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Padding" Value="5,0,5,0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#0080FF"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#0080FF"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#888888"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
         
            <!--#endregion-->
           
            <!--//////////////////////////////////////////////////////////////////////////////////////////////////////-->
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="FontFamily" Value="Tajawal"/>
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Tajawal"/>
            </Style>
            <!--<Style TargetType="DataGridCell">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>-->
            <Style x:Key="DefaultWindowStyle" TargetType="{x:Type Window}">
                <Setter Property="Height" Value="725"/>
                <Setter Property="Width" Value="1360"/>
                <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
                <Setter Property="WindowStyle" Value="ThreeDBorderWindow"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
