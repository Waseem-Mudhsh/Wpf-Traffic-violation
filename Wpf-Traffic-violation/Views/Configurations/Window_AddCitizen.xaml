<Window x:Class="Wpf_Traffic_violation.Views.Window_AddCitizen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:Convert="clr-namespace:Wpf_Traffic_violation.Converter"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" x:Name="Wondow_AddCitizen1"
        xmlns:w="clr-namespace:Wpf_Traffic_violation.ViewModel"
        Title="Window_AddCitizen" Height="300" Width="1200" FlowDirection="RightToLeft" BorderThickness="1" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" BorderBrush="#FFDD2C00" WindowStyle="None" ScrollViewer.VerticalScrollBarVisibility="Disabled"  ResizeMode="NoResize">
    <Window.Resources>
        <Convert:DateTimeConverter x:Key="converter_date"/>
    </Window.Resources>

    <DockPanel Background="WhiteSmoke" Height="300" Width="1200" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <!--/////////////////////////////////////////Top/////////////////////////////////////////////////-->
        <materialDesign:ColorZone DockPanel.Dock="Top" Background="OrangeRed">
            <StackPanel Orientation="Horizontal" Height="30" >

                <materialDesign:PackIcon Kind="Add" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"></materialDesign:PackIcon>
                <TextBlock Text="بيانات مواطن جديد" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Tajawal" FontWeight="Bold" Foreground="White"/>
                <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" HorizontalAlignment="Right" x:Name="But_close"  Width="30" Height="30" Foreground="Wheat" Background="{x:Null}" BorderBrush="{x:Null}"  Command="{Binding Closecommand}" Padding="0" Margin="1025,0,0,0" >
                    <materialDesign:PackIcon  Kind="Close" Width="24" Height="24" VerticalAlignment="Bottom"    />
                </Button>
            </StackPanel>
        </materialDesign:ColorZone>
        <!--///////////////////////////////////////////Bottom///////////////////////////////////////////////-->

        <Grid DockPanel.Dock="Bottom" Height="40">
            <Button Content=" حفــظ" Command="{Binding Savecommand,UpdateSourceTrigger=PropertyChanged}"></Button>
        </Grid>
        <!--/////////////////////////////////////////////Center/////////////////////////////////////////////-->
        <Grid FlowDirection="RightToLeft" >
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Tajawal"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Foreground" Value="#022551"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="أسم المواطن :" Margin="15 0 030 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox      Height="40" Width="240" Text="{Binding Currunt_Citizen.Citizen_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"
                        materialDesign:HintAssist.Hint="أسم المواطن..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="نوع الهوية :" Margin="25 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->
                <ComboBox Width="240" Height="40" BorderThickness="1 1 1 1" Text="{Binding Currunt_Citizen.Citizen_identitytype,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                          Padding="10,10,0,0" Background="White" Margin="10 0 25 0" FontSize="14" FontFamily="Tajawal" SelectedIndex="0">
                    <ComboBoxItem >شخصية</ComboBoxItem>
                    <ComboBoxItem Content="جواز سفر"></ComboBoxItem>
                    <ComboBoxItem>رقم جلوس</ComboBoxItem>
                    <ComboBoxItem>أنتخابية</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="رقم الهوية:" Margin="0 0 30 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox    x:Name="textBox_citizenid"   Height="40" Width="240" Text="{Binding Currunt_Citizen.Citizen_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"
                        materialDesign:HintAssist.Hint="رقم الهوية ..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" FontFamily="Tajawal" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <TextBlock Text="الجنسية :" Margin="15 0 030 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox      Height="40" Width="240" Text="{Binding Currunt_Citizen.Citizen_nationality,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="الجنسية..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="الجنس :" Margin="28 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->
                <RadioButton x:Name="Radiobutton_gender" 
                              IsChecked="True" Margin="10,0,0,8" Content="ذكر" FontSize="14" FontFamily="Tajawal" Width="64" />
                <RadioButton 
                              IsChecked="False" Margin="50,0,0,8" Content="أنثى" Width="64" FontSize="14" FontFamily="Tajawal" />
                <TextBlock Text="الديانة :" Margin="88 0 27 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox      Height="40" Width="240" Text="{Binding Currunt_Citizen.Citizen_religion,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"
                        materialDesign:HintAssist.Hint="الديانة ..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" FontFamily="Tajawal" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock Text="تاريخ الميلاد :" Margin="15 0 030 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <DatePicker x:Name="Datepicker_date" SelectedDateFormat="Short" Text="{Binding Currunt_Citizen.Citizen_date_pirth,UpdateSourceTrigger=PropertyChanged,StringFormat='{}{0:  dd/MM/yyyy}'}"
                             Width="240" Height="40" Background="White" FontFamily="Tajawal" FontSize="14" BorderThickness="1"  FirstDayOfWeek="Saturday" />
                <TextBlock Text="فصيلة الدم :" Margin="25 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
               
                <ComboBox  Width="240" Height="40" Text="{Binding Currunt_Citizen.Citizen_blood_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                          Padding="10,10,0,0" Background="White" Margin="10 0 25 0" FontFamily="Tajawal" FontSize="14" BorderThickness="1" SelectedIndex="0">
                    <ComboBoxItem>+ O</ComboBoxItem>
                    <ComboBoxItem>- O</ComboBoxItem>
                    <ComboBoxItem>+ A</ComboBoxItem>
                    <ComboBoxItem>- A</ComboBoxItem>
                    <ComboBoxItem>+ AB</ComboBoxItem>
                    <ComboBoxItem>- AB</ComboBoxItem>
                    <ComboBoxItem>- B</ComboBoxItem>

                </ComboBox>
                <TextBlock Text="الحالة الأجتماعية :" Margin="0,18,4,17" HorizontalAlignment="Center" VerticalAlignment="Center" Width="126"/>
                <ComboBox Width="240" Height="40" Text="{Binding Currunt_Citizen.String_social_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                          Padding="10,10,0,0" Background="White" Margin="0 0 25 0" FontFamily="Tajawal" FontSize="14" BorderThickness="1" SelectedIndex="0">
                    <ComboBoxItem >عازب</ComboBoxItem>
                    <ComboBoxItem>متزوج</ComboBoxItem>

                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <TextBlock Text="العنوان :" Margin="15 0 30 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox      Height="40" Width="240" Text="{Binding Currunt_Citizen.Citizen_address,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="العنون..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,7.5,0,10.5" FontFamily="Tajawal" FontSize="14" />

                <TextBlock Text="رقم التلفون:" Margin="27 0 33 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox    x:Name="textBox8"   Height="40" Width="240" Text="{Binding Currunt_Citizen.Citizen_phone,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="رقم التلفون ..." BorderThickness="1"
                          Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" FontFamily="Tajawal" FontSize="14" />
            </StackPanel>

        </Grid>
        <!--نستحدم الفريم هذا أذا كنا نشتي نستخدم يوزركنترول-->
        <!--<Frame x:Name="Frame_Window" NavigationUIVisibility="Hidden" Width="1300" Height="270"></Frame>-->
    </DockPanel>
</Window>
