<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_Configuration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
            d:DesignHeight="625" d:DesignWidth="1360" >
    <DockPanel Background="Gray" >
        <StackPanel DockPanel.Dock="Top"  Background="White" Height="65" >

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" 
                        >

                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                          Uid="11" x:Name="but8" Margin="0,4,7,4" Click="but_sub_ButtonClick">
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="Report"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >أسباب الإعتراض</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                          Uid="10" x:Name="but10" Margin="0,4,7,4" Click="but_sub_ButtonClick">
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="Road"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >الشوارع</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                          Uid="9" x:Name="but9" Margin="0,4,7,4" Click="but_sub_ButtonClick">
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="LocationCity"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >المديريات</TextBlock>
                    </StackPanel>
                </Button>
                <Button  Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                           Uid="8" x:Name="but5" Margin="0,4,7,4" Click="but_sub_ButtonClick" >
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="TrafficCone"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >أنواع المخالفات</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                          Uid="7" x:Name="but11" Margin="0,4,7,4" Click="but_sub_ButtonClick">
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="DesktopWindows"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >بيانات اللوحة</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                          Uid="6" x:Name="but6" Margin="0,4,7,4" Click="but_sub_ButtonClick">
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="AspectRatio"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >أنواع اللوحات</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                           Uid="5" x:Name="but4" Margin="0,4,7,4" Click="but_sub_ButtonClick" >
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="DriversLicense"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >بيانات الرخص</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                          Uid="4" x:Name="but7" Margin="0,4,7,4" Click="but_sub_ButtonClick">
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="Toc"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >فئات الرخص</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                           Uid="3" x:Name="but3" Margin="0,4,7,4"  Click="but_sub_ButtonClick">
                    <StackPanel Orientation="Vertical" >
                        <materialDesign:PackIcon Kind="DriveEta"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >بيانات المركبة</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                           Uid="2" x:Name="but2" Margin="0,4,7,4" Click="but_sub_ButtonClick" >
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="CardAccountDetailsOutline"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >بيانات المواطن</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                           Uid="1" x:Name="but1" Margin="0,4,7,4" Click="but_sub_ButtonClick" >
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="CardAccountDetailsStarOutline"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >بيانات رجل المرور</TextBlock>
                    </StackPanel>
                </Button>


            </StackPanel>

        </StackPanel>
        <Frame x:Name="Frame_Configuration" DockPanel.Dock="Bottom" Height="560" BorderThickness="1" BorderBrush="Blue" NavigationUIVisibility="Hidden">
            <Frame.Background>
                <ImageBrush ImageSource="/Wpf-Traffic-violation;component/Assets/Configuration.png"/>
            </Frame.Background>

        </Frame>

    </DockPanel>
</UserControl>
