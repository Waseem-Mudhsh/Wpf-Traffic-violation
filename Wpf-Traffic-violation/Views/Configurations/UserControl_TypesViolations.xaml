<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_TypesViolations"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             xmlns:ViewModel="clr-namespace:Wpf_Traffic_violation.ViewModel"
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="1360">
    <UserControl.DataContext>
        <ViewModel:ViolationType_ViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <DataTemplate x:Key="AutoId">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding  Search}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderThickness="0 0 0 1" BorderBrush="Blue">
            <StackPanel  Height="60" Background="WhiteSmoke" Orientation="Horizontal" >

                <!--top-->

                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="60 0 20 0" FlowDirection="RightToLeft" >
                    <Button  Height="40" Width="40" Padding="0" Background="OrangeRed" VerticalAlignment="Center" HorizontalAlignment="Center"  materialDesign:ShadowAssist.ShadowDepth="Depth0" BorderBrush="{x:Null}">
                        <materialDesign:PackIcon Kind="Search" Width="32" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"></materialDesign:PackIcon>
                    </Button>
                    <controls:AutoCompleteBox Width="400" ItemsSource="{Binding Grid_ViolationTypes }" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="20 8 0 5" 
                                              ValueMemberPath="Search" 
                                              SelectedItem="{Binding Currunt_ViolationType , Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" FilterMode="Contains"
                                              />
                </StackPanel>
                <Button Visibility="Hidden" Command="{Binding Excelcommand}"
                                   Height="40"          Uid="7"  x:Name="but1" Padding="0"  Margin="0,0,175,0" Background="#FF097221" BorderBrush="{x:Null}" >
                    <StackPanel Orientation="Horizontal" Margin="12 0 12 0" HorizontalAlignment="Center">
                        <TextBlock  VerticalAlignment="Center">إستيراد من أكسل</TextBlock>
                        <materialDesign:PackIcon Kind="FileExcel" Margin="8 0 0 0" Width="24" Height="24" HorizontalAlignment="Right" />
                    </StackPanel>
                </Button>
                <Button  x:Name="But_Delete_TypeViolation" Command="{Binding Deletecommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="230,0,0,0" Width="80" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">حذف</TextBlock>
                        <materialDesign:PackIcon Kind="Delete" Margin="5 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button  x:Name="But_Edit_TypeViolation" Command="{Binding Editcommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0" Width="80" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">تعديل</TextBlock>
                        <materialDesign:PackIcon Kind="Edit" Margin="5 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button  x:Name="But_Add_TypeViolation" Command="{Binding Addcommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0" Width="80" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">إضافة</TextBlock>
                        <materialDesign:PackIcon Kind="Add" Margin="5 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>

            </StackPanel>

        </Border>
        <StackPanel  Background="White" >

            <DataGrid Style="{StaticResource Style_Datagrid}" IsReadOnly="True" ItemsSource="{Binding Grid_ViolationTypes}"  SelectedItem="{Binding Currunt_ViolationType , UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:DataGridAssist.ColumnHeaderPadding="0 0 0 0"
                           Height="475"  MaxWidth="1300" Margin="5,5,5,0"
                          >
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <EventSetter Event="Selected" Handler="DataGridCell_Selected"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Resources>

                </DataGrid.Resources>
                <DataGrid.Columns>

                    <DataGridTextColumn Binding="{Binding Violation_type_id}"
                                        Header="رقم المخالفة" MinWidth="150" MaxWidth="200"
                                         />
                    <DataGridTextColumn Binding="{Binding Violation_type_name}"
                                        Header="أسم المخالفة" MinWidth="300" MaxWidth="500"
                                         />
                    <!--if you want to use the pop up style (MaterialDesignDataGridTextColumnPopupEditingStyle), you must use MaterialDataGridTextColumn-->
                    <materialDesign:DataGridTextColumn Binding="{Binding Minimum_price}"
                                                           Header="الحد الادنى"  MinWidth="100" MaxWidth="150"
                                                            
                                                           />
                    <!-- set a max length to get an indicator in the editor -->
                    <materialDesign:DataGridTextColumn Binding="{Binding Maximum_price}"
                                                           Header="الحد الأعلى"
                                                       MinWidth="100" MaxWidth="150"
                                                           
                                                           />
                 
                    <materialDesign:DataGridTextColumn Binding="{Binding Penalty}"
                                                           Header="الغرامة"  MinWidth="100"  MaxWidth="150"
                                                          
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <DataGridCheckBoxColumn Binding="{Binding Interception_status}"
                                        Header="حالة الإعتراض" MaxWidth="120" MinWidth="100" 
                                         
                                         />



                    <!-- use custom combo box column to get better combos. Use ItemsSourceBinding as your binding template to be applied to each combo -->

                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</UserControl>
