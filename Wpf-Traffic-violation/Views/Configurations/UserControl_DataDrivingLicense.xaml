<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_DataDrivingLicense"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             xmlns:ViewModel="clr-namespace:Wpf_Traffic_violation.ViewModel"
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="1360">
    <UserControl.DataContext>
        <ViewModel:DrivingLicense_ViewModel/>
    </UserControl.DataContext>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderThickness="0 0 0 1" BorderBrush="Blue">
            <StackPanel  Height="60" Background="WhiteSmoke" Orientation="Horizontal" >

                <!--top-->
                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="60 0 20 0" FlowDirection="RightToLeft" >
                    <Button  Height="40" Width="40" Padding="0" Background="OrangeRed" VerticalAlignment="Center" HorizontalAlignment="Center"  materialDesign:ShadowAssist.ShadowDepth="Depth0" BorderBrush="{x:Null}">
                        <materialDesign:PackIcon Kind="Search" Width="32" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"></materialDesign:PackIcon>
                    </Button>
                    <controls:AutoCompleteBox Width="400" ItemsSource="{Binding Grid_DrivingLicense }" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="20 8 0 5" 
                                              ValueMemberPath="Search" 
                                              SelectedItem="{Binding Current_DrivingLicense , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FilterMode="Contains"
                                              />
                </StackPanel>
                <Button   Command="{Binding Excelcommand}"
                                   Height="40"          Uid="7"  x:Name="but1" Padding="0" Margin="0,0,175,0" Background="#FF097221" BorderBrush="{x:Null}" >
                    <StackPanel Orientation="Horizontal" Margin="12 0 12 0" HorizontalAlignment="Center">
                        <TextBlock  VerticalAlignment="Center">إستيراد من أكسل</TextBlock>
                        <materialDesign:PackIcon Kind="FileExcel" Margin="8 0 0 0" Width="24" Height="24" HorizontalAlignment="Right" />
                    </StackPanel>
                </Button>
                <Button  x:Name="But_Delete_DrivingLicense"  Command="{Binding Deletecommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="230,0,0,0" Width="80" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">حذف</TextBlock>
                        <materialDesign:PackIcon Kind="Delete" Margin="5 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button  x:Name="But_Edit_DrivingLicense"  Command="{Binding Editcommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0" Width="80" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">تعديل</TextBlock>
                        <materialDesign:PackIcon Kind="Edit" Margin="5 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button  x:Name="But_Add_DrivingLicense" Command="{Binding Addcommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0" Width="80"  >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">إضافة</TextBlock>
                        <materialDesign:PackIcon Kind="Add" Margin="5 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>

            </StackPanel>

        </Border>
        <StackPanel  Background="White" >

            <DataGrid Style="{StaticResource Style_Datagrid}" Margin="10 5 5 5" ItemsSource="{Binding Grid_DrivingLicense}"  SelectedItem="{Binding Current_DrivingLicense, UpdateSourceTrigger=PropertyChanged}"
                          MaxWidth="1300" HorizontalAlignment="Right" Height="475"
                          >
                <DataGrid.Columns>

                    <DataGridTextColumn Binding="{Binding Driving_license_id}"
                                        Header="رقم الرخصة" MinWidth="100"
                                         />
                    <DataGridTextColumn Binding="{Binding Release_date}"
                                                           Header="تاريخ الأصدار"  MinWidth="80"
                                                           />
                    <DataGridTextColumn Binding="{Binding Citizen_id}"
                                                           Header="رقم المواطن"
                                                       MinWidth="80" 
                                                    />
                    <DataGridTextColumn Binding="{Binding String_citizen}"
                                                        Header="أسم المواطن"  MinWidth="150" 
                                                     />


                    <DataGridTextColumn Binding="{Binding String_Class_license}"
                                                           Header="نوع الفئة"  MinWidth="80"
                                                           />
                    <DataGridTextColumn Binding="{Binding Date_frist_license}"
                                                           Header="تاريخ أول رخصة"  MinWidth="80"
                                                           />
                    <DataGridTextColumn Binding="{Binding Status}"
                                                           Header="الحالة"  MinWidth="80"
                                                         />
                  
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</UserControl>
