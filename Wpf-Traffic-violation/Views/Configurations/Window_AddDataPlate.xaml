<Window x:Class="Wpf_Traffic_violation.Views.Configurations.Window_AddDataPlate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_Traffic_violation.Views.Configurations"
        xmlns:ViewModel="clr-namespace:Wpf_Traffic_violation.ViewModel"
        mc:Ignorable="d"
        Title="Window_AddDataPlate"  Height="300" Width="850" FlowDirection="RightToLeft" BorderThickness="1" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" BorderBrush="#FFDD2C00" WindowStyle="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" ResizeMode="NoResize">
    
    <DockPanel Background="WhiteSmoke" Height="300" Width="850" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <!--/////////////////////////////////////////Top/////////////////////////////////////////////////-->
        <materialDesign:ColorZone DockPanel.Dock="Top" Background="OrangeRed">
            <StackPanel Orientation="Horizontal" Height="30" >

                <materialDesign:PackIcon Kind="Add" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="6 0 0 0"></materialDesign:PackIcon>
                <TextBlock Text="بيانات لوحة معدنية" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Tajawal" FontWeight="Bold" Foreground="White"/>
                <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" HorizontalAlignment="Right" x:Name="But_close"  Width="30" Height="30" Foreground="Wheat" Background="{x:Null}" BorderBrush="{x:Null}" Command="{Binding Closecommand}"  Padding="0" Margin="670,0,0,0" >
                    <materialDesign:PackIcon  Kind="Close" Width="24" Height="24" VerticalAlignment="Bottom"    />
                </Button>
            </StackPanel>
        </materialDesign:ColorZone>
        <!--///////////////////////////////////////////Bottom///////////////////////////////////////////////-->

        <Grid DockPanel.Dock="Bottom" Height="40">
            <Button Content=" حفــظ" Command="{Binding Savecommand}"></Button>
        </Grid>
        <!--/////////////////////////////////////////////Center/////////////////////////////////////////////-->
        <Grid FlowDirection="RightToLeft" >
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Tajawal"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Foreground" Value="#022551"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="رقم التسلسلي :" Margin="15 0 030 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>
                <TextBox    x:Name="textBox"   Height="40" Width="240" IsReadOnly="True"
                        materialDesign:HintAssist.Hint="رقم التسلسلي..." Text="{Binding Current_Plate.Plate_id,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="#FFECECEC" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
               

            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <TextBlock Text="تاريخ الإصدار :" Margin="15 0 030 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>

                <DatePicker  materialDesign:HintAssist.Hint="التاريخ ..."  Text="{Binding Current_Plate.Release_date,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Width="240" Height="40" Background="White" FontFamily="Tajawal" FontSize="14" Margin="0,9"/>
                <TextBlock Text="مكان الإصدار :" Margin="40 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="110"/>

                <ComboBox Name="com" Width="240" Height="40" BorderThickness="1 1 1 1" ItemsSource="{Binding Grid_Provinces}"
                           SelectedItem="{Binding Selected_Provinces,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" 
                          Padding="10,10,0,0" Background="White" Margin="0 0 5 0" FontSize="14" FontFamily="Tajawal" >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="ComboBox_Provinces" Text="{Binding Province_name ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock Text="رقم اللوحة :" Margin="17 0 028 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>
                <TextBox Text="{Binding Path=Selected_Provinces.Province_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" IsEnabled="False" HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40"
                           Background="White" Margin="0 0 0 0" FontFamily="Tajawal" FontSize="14" BorderThickness="1"/>
                <TextBox  Text="{Binding Current_Plate.Plate_num,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"     Height="40" Width="188.167"
                        materialDesign:HintAssist.Hint="رقم اللوحة..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="12 9 0 9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="نوع اللوحة :" Margin="42 0 13 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>

                <ComboBox Name="com1" Width="240" Height="40" ItemsSource="{Binding Grid_PlateType}" SelectedItem="{Binding Selected_PlateType ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                          Padding="10,10,0,0" Background="White" Margin="0 0 25 0" FontFamily="Tajawal" FontSize="14" BorderThickness="1">
                    <ComboBox.ItemTemplate >
                        <DataTemplate>
                            <TextBlock x:Name="ComboBox_Provinces" Text="{Binding Plate_type_name ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>


                </ComboBox>

            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <TextBlock Text="رقم المركبة :" Margin="15 0 51 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox       Height="40" Width="240" Text="{Binding Current_Plate.Vehicle_id,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                        materialDesign:HintAssist.Hint="رقم التسلسلي..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="الحالة :" Margin="42 0 13 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>
                <ComboBox Name="com2" Text="{Binding Current_Plate.String_Status,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Width="240" Height="40"
                          Padding="10,10,0,0" Background="White" Margin="0 0 25 0" FontFamily="Tajawal" FontSize="14" BorderThickness="1">
                    <ComboBoxItem IsSelected="True">نشطة</ComboBoxItem>
                    <ComboBoxItem Content="منتهية"/>
                    <ComboBoxItem>مفقودة</ComboBoxItem>


                </ComboBox>

            </StackPanel>

        </Grid>
        <!--نستحدم الفريم هذا أذا كنا نشتي نستخدم يوزركنترول-->
        <!--<Frame x:Name="Frame_Window" NavigationUIVisibility="Hidden" Width="1300" Height="270"></Frame>-->
    </DockPanel>
</Window>
