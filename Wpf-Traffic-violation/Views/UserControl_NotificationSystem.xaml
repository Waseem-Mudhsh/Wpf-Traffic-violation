<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_NotificationSystem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             mc:Ignorable="d" 
              d:DesignHeight="560" d:DesignWidth="1360">
    <DockPanel Background="White">
        <!--<Grid DockPanel.Dock="Top" Background="#eceff1" >

            <StackPanel  Orientation="Horizontal" Margin="4" HorizontalAlignment="Center">

                
                <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4" IsChecked="False" Content="خصائص الطباعة" Uid="2"  />
                <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4" IsChecked="False" Content="خصائص الإدارة" Uid="1" />
            </StackPanel>
        </Grid>
      
        <Frame DockPanel.Dock="Top"   x:Name="GridPageFrom1"   NavigationUIVisibility="Hidden"  Background="White" />-->
        <Grid FlowDirection="RightToLeft"  DockPanel.Dock="Top" Background="#eceff1" Height="150" Margin="5" >

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Tajawal"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="#022551"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Width" Value="210"/>

                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="61*"/>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="208"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="أسم النظام :" Margin="15 0 030 0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBox    x:Name="textBox"   
                        materialDesign:HintAssist.Hint="أسم النظام..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="الأسم المختصر :" Margin="15 0 15 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->
                <TextBox      
                        materialDesign:HintAssist.Hint="الأسم المختصر..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="2 0 0 0" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="المجال:" Margin="15 0 22 0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBox    x:Name="textBox1"  
                        materialDesign:HintAssist.Hint="المجال ..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" FontFamily="Tajawal" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="العنوان :" Margin="15 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="77"/>
                <TextBox     
                        materialDesign:HintAssist.Hint="العنوان..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="05 9 0 9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="الإيميل :" Margin="14 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="91"/>
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->
                <TextBox      
                        materialDesign:HintAssist.Hint="الإيميل..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="تلفون :" Margin="15,16,25,16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBox    
                        materialDesign:HintAssist.Hint="المجال ..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" FontFamily="Tajawal" FontSize="14" />


            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" >
                <TextBlock Text="السنة المالية :" Margin="15 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <DatePicker  materialDesign:HintAssist.Hint="التاريخ ..."  Width="210" Height="30" Background="White" FontFamily="Tajawal" FontSize="14" BorderThickness="1"/>
                <TextBlock Text="الحالة :" Margin="15 0 19 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->
                <ToggleButton Style="{StaticResource MaterialDesignSwitchAccentToggleButton}"
                              ToolTip="MaterialDesignSwitchAccentToggleButton" IsChecked="False" Margin="10  0 0 0" Width="53" />
            </StackPanel>
            <StackPanel  Grid.Column="1" Grid.RowSpan="3" >
                <Button  Width="145" Height="34" x:Name="but_SelectLogo" Click="but_SelectLogo_Click" Margin="5"  HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="123">
                        <materialDesign:PackIcon Kind="Select"   Width="24" Height="24"    HorizontalAlignment="Center"/>
                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="10 2 2 2 " >تحديد شعار</TextBlock>
                    </StackPanel>
                </Button>
                <Border  Width="145" Height="100"   BorderThickness="2" BorderBrush="LightBlue" materialDesign:ShadowAssist.ShadowDepth="Depth2" Background="White" HorizontalAlignment="Left" Margin="5 0" >
                    <StackPanel Orientation="Vertical"   >
                        <Image x:Name="logo" Width="145" Height="100" Stretch="Fill" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel  Grid.Column="2" Grid.RowSpan="3" >
                <Button  Width="100" Height="34"   Margin="0 30 0 10"  HorizontalAlignment="Center" >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="75">
                        <materialDesign:PackIcon Kind="ContentSave"   Width="24" Height="24"    HorizontalAlignment="Center"/>
                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="10 2 2 2 " >حفظ</TextBlock>
                    </StackPanel>
                </Button>
                <Button  Width="100" Height="34"   Margin="5"  HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="75">
                        <materialDesign:PackIcon Kind="Edit"   Width="24" Height="24"    HorizontalAlignment="Center"/>
                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="10 2 2 2 " >تعديل</TextBlock>
                    </StackPanel>

                </Button>
            </StackPanel>
        </Grid>
        <Grid DockPanel.Dock="Top" Background="#eceff1" Margin="5 0 5 5"  >

            <StackPanel  Orientation="Horizontal" Margin="4" HorizontalAlignment="Center">

                
                <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4" FontFamily="Tajawal" FontWeight="Bold" IsChecked="False" Content="خصائص الطباعة" Uid="2" Click="RadioButton_Click" />
                <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4" FontFamily="Tajawal" FontWeight="Bold" IsChecked="False" Content="خصائص الإدارة" Uid="1" Click="RadioButton_Click" />
            </StackPanel>
        </Grid>
        <Frame DockPanel.Dock="Top"   x:Name="Frame_Property"   NavigationUIVisibility="Hidden"  Background="White" />



    </DockPanel>
</UserControl>
