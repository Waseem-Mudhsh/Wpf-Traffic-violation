<UserControl x:Class="Wpf_Traffic_violation.Views.UserControlForm1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             >
  
    <DockPanel Background="{x:Null}">
        <!--panalDock top-->

        <Grid   Background="#eceff1" DockPanel.Dock="Top"  Height="40" Margin="0,0,0,0" ><!--decrease margin 0 5 0 0 and background null-->

            <StackPanel Orientation="Horizontal" Background="#F1F2F2"   Height="40"   VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Button Style="{StaticResource sub_but_From}" HorizontalAlignment="Right"  
                                       Uid="1002" Click="but1_Click" x:Name="Reports" Margin="0,0,0,0"  
                        Visibility="{Binding HasPermission, ConverterParameter=Reports}">
                    
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock  VerticalAlignment="Center"><Run FlowDirection="RightToLeft" Text="التقارير"/></TextBlock>
                        <materialDesign:PackIcon Kind="Assignment" Margin="12 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button  Style="{StaticResource sub_but_From}" HorizontalAlignment="Right"  
                                         Uid="1003" Click="but1_Click" x:Name="Settings" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center">الأعدادات</TextBlock>

                        <!--<Image  Margin="12 0 0 0" Width="24" Height="24" Source="/Wpf-Traffic-violation;component/Assets/icons8_open_in_browser.ico" OpacityMask="#FFD60D0D"  />-->
                        <materialDesign:PackIcon Kind="Settings" Margin="12 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource sub_but_From}" HorizontalAlignment="Right"  
                                       BorderBrush="Gray" Uid="1004" Click="but1_Click" x:Name="but2" Margin="0,0,0,0" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center"><Run FlowDirection="RightToLeft" Text="التهيئة"/></TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap" Margin="12 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button  Style="{StaticResource sub_but_From}" HorizontalAlignment="Right"  
                                         Uid="1005" Click="but1_Click" x:Name="Users" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center">المستخدمين</TextBlock>

                        <!--<Image  Margin="12 0 0 0" Width="24" Height="24" Source="/Wpf-Traffic-violation;component/Assets/icons8_open_in_browser.ico" OpacityMask="#FFD60D0D"  />-->
                        <materialDesign:PackIcon Kind="Users" Margin="12 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <!--<Button Style="{StaticResource sub_but_From}" HorizontalAlignment="Right"  
                                      Uid="4" Click="but1_Click" x:Name="but3" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center">الحسابات</TextBlock>
                        <materialDesign:PackIcon Kind="LocalAtm" Margin="12 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>-->
                <!--<Button Style="{StaticResource sub_but_From}" HorizontalAlignment="Right"  
                                      Uid="4" Click="but1_Click" x:Name="but3" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center">الحجز</TextBlock>
                        <materialDesign:PackIcon Kind="CarBack" Margin="12 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>-->
                
                <Button Style="{StaticResource sub_but_From}" HorizontalAlignment="Right"  
                                       Uid="1008" Click="but1_Click" x:Name="Objections" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center">الأعتراضات</TextBlock>
                        <materialDesign:PackIcon Kind="HandLeft" Margin="14 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource sub_but_From}" HorizontalAlignment="Right"  
                                       Uid="3" Click="but1_Click" x:Name="but4" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center">البلاغات</TextBlock>
                        <materialDesign:PackIcon Kind="Warning" Margin="12 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource sub_but_From}" HorizontalAlignment="Right"  
                                      Uid="1007" Click="but1_Click" x:Name="Incidents" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center">الحجز</TextBlock>
                        <materialDesign:PackIcon Kind="CarBack" Margin="12 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource sub_but_From}" HorizontalAlignment="Right"  
                                      Uid="1009" Click="but1_Click" x:Name="Violations" Margin="0,0,1,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center">المخالفات</TextBlock>
                        <materialDesign:PackIcon Kind="TrafficLight" Margin="12 0 0 0" Width="24" Height="24"  />
                    </StackPanel>
                </Button>


            </StackPanel>
            
        </Grid>
        <Frame DockPanel.Dock="Top"  x:Name="GridPageFrom1"   NavigationUIVisibility="Hidden" />

        <!--<StackPanel DockPanel.Dock="Top"  Background="Gray" Width="1360" Height="625" x:Name="StackPanelForm1">
            <Button  Margin="188"></Button>
        </StackPanel>-->

    </DockPanel>
</UserControl>
