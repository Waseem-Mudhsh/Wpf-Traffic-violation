<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:ViewModel="clr-namespace:Wpf_Traffic_violation.ViewModel"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             mc:Ignorable="d"
          >
    
    <UserControl.DataContext>
        <ViewModel:QueryPersonalNumber_ViewModel/>
    </UserControl.DataContext>
    <Grid x:Name="Grid_Login">
        <Grid.Background>
            <!--EndPoint="1,0.5" StartPoint="0,0.5"-->
            <LinearGradientBrush EndPoint="0,0.5" StartPoint="1,0.5" >
                <!--<GradientStop Color="#FF2281D1"/>
                <GradientStop Color="#FF34268A" Offset="1"/>
                <GradientStop Color="#FF332888" Offset="0.5"/>-->
                <!--/////////////////////////////////////////-->
                <GradientStop Color="#277891" Offset="0.6"/>
                <GradientStop Color="#35868E" Offset="0.8"/>
                <GradientStop Color="#4B8891" Offset="1"/>
                <GradientStop Color="#103B72" />

            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel  HorizontalAlignment="Left">
            <TextBlock FontFamily="Adobe Devanagari" FontWeight="Regular" FontSize="30" Foreground="White" HorizontalAlignment="Center" Margin="0,100,0,0"
                >TRAFFIC VIOLATIONS MANAGEMENT SYSTEM</TextBlock>
            <TextBlock Margin="45 0 0 20" FontFamily="Adobe Devanagari" FontWeight="Regular" FontSize="30" Foreground="#00D9FF">TAIZ GOVERNORATE</TextBlock>
            <Image  Source="..\Assets\Screenshot_20200119_210524_com.facebook.katana copy.png" Width="350" VerticalAlignment="Center" Height="350" Margin="140 30 140 10" />
        </StackPanel>
        <StackPanel   HorizontalAlignment="Right">
            <!--<Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" x:Name="But_close"  Width="30" Height="30" Background="{x:Null}" BorderBrush="{x:Null}"  Margin="610 10 0 0" Click="But_close_Click" Padding="0" >
                <materialDesign:PackIcon Foreground="White" Kind="Power" Width="24" Height="24" VerticalAlignment="Bottom"    />
            </Button>-->
            <TextBlock FontFamily="Tajawal" FontWeight="Regular" FontSize="30" Margin="0 55 45 0" Foreground="White" HorizontalAlignment="Right" 
                ><Run Text="نظام إدارة المخالفات المرورية"/></TextBlock>
            <TextBlock  FontFamily="Tajawal" FontWeight="Regular" FontSize="30" Foreground="#00D9FF" Margin="0 0 45 20" HorizontalAlignment="Right"><Run Text="محافظة تعز"/></TextBlock>
            <Grid Height="300" Margin="0 70 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="40" Height="80" Background="#103B72" BorderThickness="2" BorderBrush="#00D9FF" Margin="260,10,50,10">
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Background="{x:Null}">
                        <Ellipse Width="80" HorizontalAlignment="Right" Margin="-2 -1 0 -1" Height="78" >
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Wpf-Traffic-violation;component/Assets/Group 59.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBox Name="username" Width="254" HorizontalAlignment="Left" TabIndex="1" 
                             materialDesign:HintAssist.Hint="أسم المستخدم" FontFamily="Tajawal" FontSize="22" Padding="10 " Foreground="#00D9FF" Opacity="40" 
                             />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" CornerRadius="40" Height="80" Background="#103B72" BorderThickness="2" BorderBrush="#00D9FF" Margin="260,10,50,10">
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Background="{x:Null}">
                        <Ellipse Width="80" HorizontalAlignment="Right" Margin="-2 -1 0 -1" Height="78" >
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Wpf-Traffic-violation;component/Assets/Group 60.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <PasswordBox Name="password"  Width="254" HorizontalAlignment="Left" TabIndex="2"
                             materialDesign:HintAssist.Hint="كلمة السر" FontFamily="Tajawal" FontSize="22" Padding="10 " Foreground="#00D9FF" Opacity="40" 
                             />
                    </StackPanel>
                </Border>
                <!--<Button Grid.Row="2" Style="{StaticResource MaterialDesignRaisedDarkButton}"
                            Height="60" Width="180" Margin=" 00 0 0 0"
                            materialDesign:ButtonAssist.CornerRadius="30"
                            ToolTip="MaterialDesignRaisedDarkButton with Round Corners">
                <TextBlock Text="تسجيل الدخول" FontFamily="Tajawal" FontSize="18" FontWeight="Medium"/>
            </Button>-->
                <Button Grid.Row="2" x:Name="but_Login" Click="but_Login_Click"
                            Height="60" Width="180" Background="#00D9FF"
                            materialDesign:ButtonAssist.CornerRadius="30" TabIndex="3"
                             Margin="450,20,50,20" BorderBrush="{x:Null}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="تسجيل الدخول" FontFamily="Tajawal" FontSize="18" FontWeight="Medium" VerticalAlignment="Center"/>
                        <materialDesign:PackIcon Kind="Login" Width="34" Height="34"/>
                    </StackPanel>
                </Button>

            </Grid>
        </StackPanel>
    </Grid>

</UserControl>
