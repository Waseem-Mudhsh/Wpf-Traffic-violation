<UserControl x:Class="Wpf_Traffic_violation.Views.Reports.Users.UserControl_Report_Users"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views.Reports"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ViewModel="clr-namespace:Wpf_Traffic_violation.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="1360">
    <!--<UserControl.DataContext>
        <ViewModel:ReportUser_ViewModel/>
    </UserControl.DataContext>-->
    <Grid Height="560">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="250"/>

        </Grid.ColumnDefinitions>
        <!--///////////////////////// Buttons////////////////////////////////////-->
        <Grid Grid.Column="1" Background="WhiteSmoke">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1">
                <Button Uid="1" Name="but1" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Click="Button_Click" Margin="10" >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   > كشف المستخدمين</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="2" Name="but2" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Click="Button_Click" >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   > كشف المجموعات</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="3" Name="but3" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Click="Button_Click"  >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   > كشف مستخدم</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="4" Name="but4" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Click="Button_Click"  >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   > كشف الصلاحيات</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="5" Name="but5" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Click="Button_Click"  >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   > كشف حركة المستخدمين</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>

                
            </StackPanel>
            
        </Grid>
        <!--///////////////////////// Search////////////////////////////////////-->
        <Frame Name="Frame_Search_users" Grid.Column="0" Background="White" NavigationUIVisibility="Hidden" ></Frame>
        <!--///////////////////////// Reports////////////////////////////////////-->

    </Grid>
</UserControl>
