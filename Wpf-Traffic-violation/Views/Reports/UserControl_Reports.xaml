<UserControl x:Class="Wpf_Traffic_violation.Views.Reports.UserControl_Reports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views.Reports"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
           >
    <DockPanel Background="Gray" >
        <StackPanel DockPanel.Dock="Top"  Background="White" Height="65">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">






                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                           Uid="1" x:Name="but1" Margin="0,4,7,4" Click="but_sub_ButtonClick" >
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    >التهيئة</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                           Uid="2" x:Name="but2" Margin="0,4,7,4" Click="but_sub_ButtonClick" >
                    <StackPanel Orientation="Vertical" Width="100" HorizontalAlignment="Center" >
                        <materialDesign:PackIcon Kind="Users"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    HorizontalAlignment="Center">المستخدمين</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                           Uid="3" x:Name="but3" Margin="0,4,7,4" Click="but_sub_ButtonClick" >
                    <StackPanel Orientation="Vertical" Width="100" HorizontalAlignment="Center" >
                        <materialDesign:PackIcon Kind="LocalAtm"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    HorizontalAlignment="Center">الحسابات</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                           Uid="4" x:Name="but4" Margin="0,4,7,4" Click="but_sub_ButtonClick" >
                    <StackPanel Orientation="Vertical" Width="100" HorizontalAlignment="Center" >
                        <materialDesign:PackIcon Kind="Warning"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    HorizontalAlignment="Center">البلاغات</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                           Uid="5" x:Name="but5" Margin="0,4,7,4" Click="but_sub_ButtonClick" >
                    <StackPanel Orientation="Vertical" Width="100" HorizontalAlignment="Center" >
                        <materialDesign:PackIcon Kind="HandLeft"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    HorizontalAlignment="Center">الإعتراضات</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource subButton}" BorderThickness="0 0 0 2"  BorderBrush="White"
                                           Uid="6" x:Name="but6" Margin="0,4,7,4" Click="but_sub_ButtonClick" >
                    <StackPanel Orientation="Vertical" Width="100" HorizontalAlignment="Center" >
                        <materialDesign:PackIcon Kind="TrafficLight"   Width="24" Height="24"  HorizontalAlignment="Center" Margin="0 0 0 4" />
                        <TextBlock    HorizontalAlignment="Center">المخالفات</TextBlock>
                    </StackPanel>
                </Button>


            </StackPanel>
        </StackPanel>
        <Frame x:Name="Frame_Report" DockPanel.Dock="Bottom" Height="560" BorderThickness="1" BorderBrush="Blue" NavigationUIVisibility="Hidden">
            <Frame.Background>
                <ImageBrush ImageSource="/Wpf-Traffic-violation;component/Assets/Reports.png"/>
            </Frame.Background>

        </Frame>

    </DockPanel>
</UserControl>