<UserControl x:Class="Wpf_Traffic_violation.Views.Reports.Objections.UserControl_Report_allObjections"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views.Reports.Objections"
             xmlns:Conver="clr-namespace:Wpf_Traffic_violation.Models.Converter"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
            mc:Ignorable="d" 
              d:DesignHeight="560" d:DesignWidth="1110" Background="Beige">
    <UserControl.Resources>
        <Conver:BoolToVisibilityConverter x:Key="Convertbool"/>

    </UserControl.Resources>
    <Grid  Background="WhiteSmoke">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <materialDesign:ColorZone CornerRadius="5"  Grid.Column="1" VerticalAlignment="Top" Margin="10" Background="#363636" Height="270">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <materialDesign:ColorZone Grid.Row="0" Height="40"  Background="DarkOrange" Margin="0 10">
                    <TextBlock Text=" كشف الأعتراضات " HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Tajawal" FontWeight="Bold" Foreground="White"/>
                </materialDesign:ColorZone>
                <Grid Grid.Row="1" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="40"/>
                        
                        <RowDefinition/>
                        <RowDefinition/>


                    </Grid.RowDefinitions>
                    <Border BorderThickness="0 0 0 0" BorderBrush="LightGray" Opacity="50" Grid.Row="0">
                        <StackPanel Orientation="Horizontal"  >
                            <TextBlock Text="حسب :" Margin="10 0 04 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="80" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Foreground="White"/>

                            <RadioButton x:Name="RadioButton_all"  GroupName="type of search" IsChecked="{Binding All}" Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White" Content="الكل" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="16 0 72 0"/>
                            <RadioButton x:Name="RadioButton_namecitizen" GroupName="type of search" IsChecked="{Binding Citi}" Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White"  Content="أسم المواطن "  FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="0 0 10 0"/>

                        </StackPanel>
                    </Border>
                    <Border BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="1">
                        <StackPanel Orientation="Horizontal"  >
                            <RadioButton x:Name="RadioButton_id" GroupName="type of search" Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White" Content="رقم الأعتراض" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="110 0 21 0"/>
                            <RadioButton x:Name="RadioButton_datemade" GroupName="type of search"  Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White"  Content="تاريخ الأعتراض"  FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="0 0 10 0"/>

                        </StackPanel>
                    </Border>


                    <Border Name="border_namecitizen" BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="2"  Visibility="{Binding ElementName=RadioButton_namecitizen, Path=IsChecked, Converter={StaticResource Convertbool}}" >
                        <StackPanel Name="Panel_usernumber" Orientation="Horizontal">

                            <TextBlock Text="أسم المواطن :" Margin="10 0 10 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Foreground="White"/>


                            <ComboBox  Name="com" Width="240" Height="40" BorderThickness="1 1 1 1" ItemsSource="{Binding Grid_citi}"
                           SelectedItem="{Binding Selected_citiz,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" 
                          Padding="10,10,0,0" Background="White" Margin="0 0 5 0" FontSize="14" FontFamily="Tajawal" >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Province_id" Text="{Binding     Citizen_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>

                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Name="border_id" BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="2"  Visibility="{Binding ElementName=RadioButton_id, Path=IsChecked, Converter={StaticResource Convertbool}}" >
                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="رقم الأعتراض :" Margin="10 0 10 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Foreground="White"/>


            
                            <ComboBox  Name="om" Width="240" Height="40" BorderThickness="1 1 1 1" ItemsSource="{Binding Grid_objection}"
                           SelectedItem="{Binding Selected_objection,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" 
                          Padding="10,10,0,0" Background="White" Margin="0 0 5 0" FontSize="14" FontFamily="Tajawal" >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Province_id" Text="{Binding Interception_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>

                            </ComboBox>

                        </StackPanel>
                    </Border>

                    <Border Name="border_datemade" BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="2" Visibility="{Binding ElementName=RadioButton_datemade, Path=IsChecked, Converter={StaticResource Convertbool}}">
                        <StackPanel  >
                            <DatePicker SelectedDate="{x:Static sys:DateTime.Now}" Text="{Binding  Selected_objection.Interception_date,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  Width="215" Height="40" Background="White" FontFamily="Tajawal" FontSize="16" BorderThickness="1" Margin="128 10 16 10" />

                        </StackPanel>
                    </Border>



                    <StackPanel  Grid.Row="3" >
                        <Button  x:Name="But_Delete_Citizen" HorizontalAlignment="Center" Margin="0 10" Command="{Binding Show_report_allobjection}"
                     Height="40"   Padding="0"    Width="140" >
                            <StackPanel Orientation="Horizontal" >
                                <materialDesign:PackIcon Kind="FileDocument" Margin="5 0 4 0" Width="24" Height="24" />
                                <TextBlock  VerticalAlignment="Center" Margin="10 0 0 0">أنشاء التقرير</TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </Grid>
            </Grid>
        </materialDesign:ColorZone>
    </Grid>
</UserControl>
