<Window x:Class="Wpf_Traffic_violation.Views.Reports.Show_Report"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_Traffic_violation.Views.Reports"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:rv="clr-namespace:Microsoft.Reporting.WinForms;assembly=Microsoft.ReportViewer.WinForms"
     
        mc:Ignorable="d"
        Title="Show_Report"  Height="900" Width="1000" FlowDirection="RightToLeft" BorderThickness="1" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" BorderBrush="#FFDD2C00" WindowStyle="ThreeDBorderWindow" ScrollViewer.VerticalScrollBarVisibility="Disabled" ResizeMode="NoResize">
   
    <Grid Background="White"  HorizontalAlignment="Center" >
        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" x:Name="But_close"  Width="30" Height="30" Background="{x:Null}" BorderBrush="{x:Null}"  Margin="0,0,0,0" Click="But_close_Click" Padding="0" >
            <materialDesign:PackIcon Foreground="White" Kind="Power" Width="24" Height="24" VerticalAlignment="Bottom"    />
        </Button>
        <WindowsFormsHost   Height="800" Width="900" HorizontalAlignment="Center" >
            <rv:ReportViewer x:Name="ReportViewerDemo"  Dock="Fill" ZoomMode="FullPage"  >
            </rv:ReportViewer>
        </WindowsFormsHost>
      
    </Grid>
</Window>
