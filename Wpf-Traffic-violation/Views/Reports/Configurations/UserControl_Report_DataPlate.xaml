<UserControl x:Class="Wpf_Traffic_violation.Views.Reports.Configurations.UserControl_Report_DataPlate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views.Reports.Configurations"
             xmlns:Conver="clr-namespace:Wpf_Traffic_violation.Models.Converter"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
             mc:Ignorable="d" 
              d:DesignHeight="560" d:DesignWidth="1110" Background="Beige">
    <UserControl.Resources>
        <Conver:BoolToVisibilityConverter x:Key="Convertbool"/>

    </UserControl.Resources>
    <Grid  Background="WhiteSmoke">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <materialDesign:ColorZone CornerRadius="5"  Grid.Column="1" VerticalAlignment="Top" Margin="10" Background="#363636" Height="430">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <materialDesign:ColorZone Grid.Row="0" Height="40"  Background="DarkOrange" Margin="0 10">
                    <TextBlock Text=" كشف اللوحات" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Tajawal" FontWeight="Bold" Foreground="White"/>
                </materialDesign:ColorZone>
                <Grid Grid.Row="1" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>

                    </Grid.RowDefinitions>
                    <Border BorderThickness="0 0 0 0" BorderBrush="LightGray" Opacity="50" Grid.Row="0">
                        <StackPanel Orientation="Horizontal"  >
                            <TextBlock Text="حسب :" Margin="10 0 04 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Foreground="White"/>

                            <RadioButton x:Name="RadioButton_all"  GroupName="type of search" IsChecked="{Binding All}" Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White" Content="الكل " FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="15 0 55 0"/>
                            <RadioButton x:Name="RadioButton_id"   GroupName="type of search" IsChecked="{Binding Numb_lis}" Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White"  Content="رقم اللوحة "  FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="0 0 10 0"/>

                        </StackPanel>
                    </Border>
                    <Border BorderThickness="0 0 0 0" BorderBrush="LightGray" Opacity="50" Grid.Row="1">
                        <StackPanel Orientation="Horizontal"  >
                            <RadioButton x:Name="RadioButton_typeplate" IsChecked="{Binding Name_citiz}" GroupName="type of search" Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White" Content="نوع اللوحة " FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="128 0 24 0"/>
                            <RadioButton x:Name="RadioButton_place" IsChecked="{Binding Date_liss}" GroupName="type of search"  Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White"  Content="مكان الأصدار "  FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="0 0 10 0"/>

                        </StackPanel>
                    </Border>
                    <Border BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="2">
                        <StackPanel Orientation="Horizontal"  >
                            <RadioButton x:Name="RadioButton_chassisnumber" IsChecked="{Binding Numb_edi}" GroupName="type of search" Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White" Content="رقم القعادة " FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="128 0 14 0"/>
                            <RadioButton x:Name="RadioButton_state" IsChecked="{Binding State_liss}" GroupName="type of search"  Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White"  Content="حالة اللوحة "  FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="0 0 10 0"/>

                        </StackPanel>
                    </Border>

                    <Border Name="border_typeplate" BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="3"  Visibility="{Binding ElementName=RadioButton_typeplate, Path=IsChecked, Converter={StaticResource Convertbool}}" >
                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="نوع اللوحة :" Margin="10 0 10 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Foreground="White"/>



                            <ComboBox  Width="240" Height="40" BorderThickness="1 1 1 1" ItemsSource="{Binding Grid_plate}"
                           SelectedItem="{Binding Selected_plate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                          Padding="10,10,0,0" Background="White" Margin="0,10,5,9" FontSize="14" FontFamily="Tajawal" >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Province_id" Text="{Binding Plate_type_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Name="border_place" BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="3"  Visibility="{Binding ElementName=RadioButton_place, Path=IsChecked, Converter={StaticResource Convertbool}}" >
                        <StackPanel  Orientation="Horizontal">

                            <TextBlock Text="مكان الأصدار :" Margin="10 0 10 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Foreground="White"/>


                            <ComboBox  Width="240" Height="40" BorderThickness="1 1 1 1" ItemsSource="{Binding Grid_plate}"
                           SelectedItem="{Binding Selected_plate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                          Padding="10,10,0,0" Background="White" Margin="0,10,5,9" FontSize="14" FontFamily="Tajawal" >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Province_id" Text="{Binding Province_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                           </StackPanel>
                    </Border>
                    <Border Name="border_id" BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="3"  Visibility="{Binding ElementName=RadioButton_id, Path=IsChecked, Converter={StaticResource Convertbool}}" >
                        <controls:AutoCompleteBox Name="B"  Width="185" ItemsSource="{Binding Grid_plate}" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="20 8 0 5"
                                              ValueMemberPath="Plate_id" 
                                              SelectedItem="{Binding  Selected_plate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding  Selected_plate.Plate_id}" FilterMode="Contains" Margin="0 9 12 9"
                                             
                                          />
                    </Border>
                    <Border Name="border_chassisnumber" BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="3"  Visibility="{Binding ElementName=RadioButton_chassisnumber, Path=IsChecked, Converter={StaticResource Convertbool}}" >
                        <controls:AutoCompleteBox Name="a"  Width="185" ItemsSource="{Binding Grid_plate}" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="20 8 0 5"
                                              ValueMemberPath="Vehicle_id" 
                                              SelectedItem="{Binding  Selected_plate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding  Selected_plate.Vehicle_id}" FilterMode="Contains" Margin="0 9 12 9"
                                             
                                          />
                    </Border>
                    
                    <Border Name="Border_state" BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="3" Visibility="{Binding ElementName=RadioButton_state, Path=IsChecked, Converter={StaticResource Convertbool}}">
                        <StackPanel Orientation="Horizontal"  >
                            <TextBlock Text="حالة الرخصة :" Margin="10 0 04 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Foreground="White"/>

                            <RadioButton x:Name="RadioButton_active" GroupName="state"  IsChecked="{Binding Act}"  Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White" Content="نشطة " FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="15 0 10 0"/>
                            <RadioButton x:Name="RadioButton_end" GroupName="state" IsChecked="{Binding Act_no}" Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White"  Content="منتهية "  FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="0 0 10 0"/>
                            <RadioButton x:Name="RadioButton_miss" GroupName="state" IsChecked="{Binding Miss}"  Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White"  Content="مفقودة "  FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="0 0 10 0"/>

                        </StackPanel>
                    </Border>


                    <Border BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="4" Visibility="{Binding ElementName=Border_state, Path=Visibility}">
                        <StackPanel Orientation="Horizontal"  >
                            <TextBlock Text="النطاق الزمني :" Margin="10 0 04 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Foreground="White"/>
                         
                            <RadioButton x:Name="RadioButton_day" GroupName="time"   Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White" Content="يوم " FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="15 0 28 0"/>
                            <RadioButton x:Name="RadioButton_date" GroupName="time"    Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White"  Content="فترة "  FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="0 0 24 0"/>
                            <RadioButton x:Name="RadioButton_year" GroupName="time"   Style="{StaticResource MaterialDesignAccentRadioButton}" Foreground="White"  Content="سنة "  FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Margin="0 0 10 0"/>

                        </StackPanel>
                    </Border>
                    <Border Name="border_day" BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="5" Visibility="{Binding ElementName=RadioButton_day, Path=IsChecked, Converter={StaticResource Convertbool}}">
                        <StackPanel Name="Panel_day" Visibility="{Binding ElementName=RadioButton_state, Path=IsChecked, Converter={StaticResource Convertbool}}"  >
                            <DatePicker SelectedDate="{x:Static sys:DateTime.Now}" Text="{Binding Current_Violation.Violation_date,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  Width="85" Height="40" Background="White" FontFamily="Tajawal" FontSize="16" BorderThickness="1" Margin="0 10 16 10" />

                        </StackPanel>
                    </Border>
                    <Border Name="border_date" BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="5" Visibility="{Binding ElementName=RadioButton_date, Path=IsChecked, Converter={StaticResource Convertbool}}">
                        <StackPanel Name="Panel_date" Orientation="Horizontal" Visibility="{Binding ElementName=RadioButton_state, Path=IsChecked, Converter={StaticResource Convertbool}}"  >
                            <!--<TextBlock Text="من :" Margin="10 0 04 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Foreground="White"/>-->
                            <DatePicker SelectedDate="{x:Static sys:DateTime.Now}" Text="{Binding Current_Violation.Violation_date,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  Width="85" Height="40" Background="White" FontFamily="Tajawal" FontSize="16" BorderThickness="1" Margin="129 10 0 10" />
                            <TextBlock Text="الى :" Margin="10 0 04 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" FontFamily="Tajawal" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <DatePicker SelectedDate="{x:Static sys:DateTime.Now}" Text="{Binding Current_Violation.Violation_date,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  Width="80" Height="40" Background="White" FontFamily="Tajawal" FontSize="16" BorderThickness="1" Margin="05 10 0 10" />

                        </StackPanel>
                    </Border>
                    <Border Name="border_year" BorderThickness="0 0 0 1" BorderBrush="LightGray" Opacity="50" Grid.Row="5" Visibility="{Binding ElementName=RadioButton_year, Path=IsChecked, Converter={StaticResource Convertbool}}">
                        <StackPanel Visibility="{Binding ElementName=RadioButton_state, Path=IsChecked, Converter={StaticResource Convertbool}}"  >
                            <DatePicker SelectedDate="{x:Static sys:DateTime.Now}" Text="{Binding Current_Violation.Violation_date,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  Width="85" Height="40" Background="White" FontFamily="Tajawal" FontSize="16" BorderThickness="1" Margin="0 10 16 10" />

                        </StackPanel>
                    </Border>


                    <StackPanel  Grid.Row="6" >
                        <Button  x:Name="But_Delete_Citizen" HorizontalAlignment="Center" Margin="0 10" Command="{Binding Report_date_plate}"
                     Height="40"   Padding="0"    Width="140" >
                            <StackPanel Orientation="Horizontal" >
                                <materialDesign:PackIcon Kind="FileDocument" Margin="5 0 4 0" Width="24" Height="24" />
                                <TextBlock  VerticalAlignment="Center" Margin="10 0 0 0">أنشاء التقرير</TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </Grid>
            </Grid>
        </materialDesign:ColorZone>
    </Grid>
</UserControl>
