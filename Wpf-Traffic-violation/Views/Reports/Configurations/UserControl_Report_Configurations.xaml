<UserControl x:Class="Wpf_Traffic_violation.Views.Reports.Configurations.UserControl_Report_Configurations"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views.Reports.Configurations"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ViewModel="clr-namespace:Wpf_Traffic_violation.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="1360">
    <UserControl.DataContext>
        <ViewModel:Report_configuration_viewmodel/>
    </UserControl.DataContext>
    <Grid Height="560">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="250"/>

        </Grid.ColumnDefinitions>
        <!--///////////////////////// Buttons////////////////////////////////////-->
        <Grid Grid.Column="1" Background="WhiteSmoke">
            <Grid.ColumnDefinitions>

                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1">

                <Button Uid="1" Name="but1" Command="{Binding Showcommand2}" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}"  Margin="0,10,10,10" Width="128" >
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock  VerticalAlignment="Center"   ><Run Text="كشف رجال المرور"/></TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="2" Command="{Binding Showcommand1}" Name="but2"   HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}"  >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   > كشف المواطنين</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="3" Name="but3" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Command="{Binding Showcommand5}"  >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   > كشف المركبات</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="4" Name="but4"   HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}"  Command="{Binding Showcommand3}"  >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   > كشف الرخص</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="5" Name="but5" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Command="{Binding Showcommand4}"   >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   > كشف اللوحات</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>

                <Button Uid="6" Name="but6" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}"   >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   >كشف أنواع اللوحات</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="7" Name="but7" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Command="{Binding Report_violatio_typ}" >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   >كشف أنواع المخالفات</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"  Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="8" Name="but8" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Command="{Binding Report_type_licence}" >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   >كشف فئات الرخص</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap" Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="9" Name="but9" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Command="{Binding Report_type_reson}"   >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   >كشف أسباب الأعتراض</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="10" Name="but10" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Command="{Binding Report_directore}"    >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   >كشف المديريات</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap"   Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
                <Button Uid="11" Name="but11" HorizontalAlignment="Right" Style="{StaticResource Repotr_Button}" Command="{Binding Showcommand6}" >
                    <StackPanel Orientation="Horizontal"  >
                        <TextBlock  VerticalAlignment="Center"   > كشف الشوارع</TextBlock>
                        <materialDesign:PackIcon Kind="Sitemap" Foreground="DarkOrange"  Width="24" Height="24"  HorizontalAlignment="Right" Margin="10 0 0 0" />
                    </StackPanel>
                </Button>
            </StackPanel>

        </Grid>
        <!--///////////////////////// Search////////////////////////////////////-->
        <Frame Name="Frame_Search_configurations" Content="{Binding Curent_usercontrol}" Grid.Column="0" Background="White" NavigationUIVisibility="Hidden" ></Frame>
        <!--///////////////////////// Reports////////////////////////////////////-->

    </Grid>
</UserControl>
