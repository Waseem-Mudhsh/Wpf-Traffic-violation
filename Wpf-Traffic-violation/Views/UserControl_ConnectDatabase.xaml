<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_ConnectDatabase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="512" d:DesignWidth="1360">
    <Grid Background="White">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Tajway"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="#022551"/>
            </Style>
        </Grid.Resources>
        <Border BorderThickness="1" BorderBrush="LightBlue" Height="272" Width="430" Margin="10 10 10 100">
        <DockPanel  HorizontalAlignment="Center" VerticalAlignment="Center" Height="272" Width="430" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="#FFF5F5F5">
           
            <!--///////////////////////////////////////////Bottom///////////////////////////////////////////////-->

            <Grid DockPanel.Dock="Bottom" Height="40">
                <Button Content=" إتصال"  VerticalAlignment="Bottom" Margin="2 0 2 2"></Button>
            </Grid>
            <!--///////////////////////////////////////////Center///////////////////////////////////////////////-->
            <Grid FlowDirection="RightToLeft">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="أسم السيرفر :" Margin="15 0 50 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100"/>
                    <TextBox       Height="40" Width="240"
                        materialDesign:HintAssist.Hint="أسم السيرفر..."
                         BorderThickness="1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="أسم قاعدة البيانات :" Margin="15 0 010 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="140"/>
                    <TextBox    x:Name="textBox"   Height="40" Width="240"
                        materialDesign:HintAssist.Hint="أسم قاعدة البيانات..."
                         BorderThickness="1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                   
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="أسم المستخدم :" Margin="15 0 40 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="110"/>
                    <TextBox       Height="40" Width="240"
                        materialDesign:HintAssist.Hint="أسم مستخدم قاعدة البيانات..."
                         BorderThickness="1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />

                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="كلمة السر :" Margin="15 0 040 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="110"/>
                    <TextBox       Height="40" Width="240"
                        materialDesign:HintAssist.Hint="كلمة سر قاعدة البيانات..."
                         BorderThickness="1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />

                </StackPanel>


            </Grid>
        </DockPanel>
        </Border>
    </Grid>
</UserControl>
