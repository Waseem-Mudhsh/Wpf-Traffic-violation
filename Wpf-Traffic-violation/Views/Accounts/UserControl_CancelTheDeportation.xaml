<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_CancelTheDeportation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             mc:Ignorable="d" 
              d:DesignHeight="462" d:DesignWidth="1360" Background="White">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="352" />

        </Grid.RowDefinitions>
        <Border BorderThickness="0 0 0 1" BorderBrush="Blue">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1100"/>
                </Grid.ColumnDefinitions>
                <StackPanel Width="190" Margin="0 0" Grid.Column="0">
                    <Button  x:Name="But_Delete_Citizen" Click="RadioButton_Date_Click"
                     Height="40" Uid="7"   Padding="0" HorizontalAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10" Width="120" >
                        <StackPanel Orientation="Horizontal" Width="86">
                            <materialDesign:PackIcon Kind="Search" Margin="5 0 8 0" Width="24" Height="24" />
                            <TextBlock  VerticalAlignment="Center" Margin="10 0 0 0">عرض</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button  
                     Height="40" Uid="7"   Padding="0" HorizontalAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10" Width="120" >
                        <StackPanel Orientation="Horizontal" Width="120">
                            <materialDesign:PackIcon Kind="Cancel" Margin="5 0 8 0" Width="24" Height="24" />
                            <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">الغاء الترحيل</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                    <StackPanel Grid.Column="1" Orientation="Vertical" FlowDirection="RightToLeft" Width="1100"   >
                        <!--top-->
                        <StackPanel Orientation="Horizontal" >
                           
                            <TextBlock Text="نوع السند :" Margin="15,14,0 14" HorizontalAlignment="Center" VerticalAlignment="Center" Width="94" FontSize="16" />
                            <RadioButton  Style="{StaticResource MaterialDesignAccentRadioButton}"  Content="صرف  "  FontFamily="Tajawal" FontSize="16" FontWeight="Bold" Margin="30 0 0 0"/>
                            <RadioButton  Style="{StaticResource MaterialDesignAccentRadioButton}"  Content="قبض "  FontFamily="Tajawal" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="344*"/>
                                <ColumnDefinition Width="756*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="نوع الترحيل :" Margin="15,14,1,14" HorizontalAlignment="Center" VerticalAlignment="Center" Width="94" FontSize="16" />
                                    <RadioButton x:Name="RadioButton_day"  Style="{StaticResource MaterialDesignAccentRadioButton}" Content="يوم  " Click="RadioButton_day_Click"  FontFamily="Tajawal" FontSize="16" FontWeight="Bold" Margin="30 0 10 0"/>
                                    <RadioButton x:Name="RadioButton_Date" Style="{StaticResource MaterialDesignAccentRadioButton}"  Content="فترة " Click="RadioButton_Date_Click" FontFamily="Tajawal" FontSize="16" FontWeight="Bold" Margin="0 0 10 0"/>
                                    <RadioButton x:Name="RadioButton_Document" IsChecked="True" Style="{StaticResource MaterialDesignAccentRadioButton}"  Content="مستند " Click="RadioButton_Document_Click"  FontFamily="Tajawal" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>

                            </StackPanel>
                            <Border x:Name="Panel_day"  Visibility="Hidden" Grid.Column="1" Width="352" BorderThickness="1" BorderBrush="OrangeRed" Margin="1 1 401 1">
                                <StackPanel  Orientation="Horizontal"  Background="White">
                                    <TextBlock Text="التاريخ :" Margin="40,14,20 14" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" FontSize="16" />
                                    <DatePicker  materialDesign:HintAssist.Hint="التاريخ ..." Width="160" Height="40" Background="White" FontFamily="Tajawal" FontSize="14" BorderThickness="2"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="panel_date"  Visibility="Hidden" Grid.Column="1" Width="660" BorderThickness="1" BorderBrush="OrangeRed" Margin="1 1 93 1">
                                <StackPanel  Orientation="Horizontal"  Grid.Column="1" Background="White">
                                    <TextBlock Text="من تاريخ  :" Margin="40,14,20 14" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" FontSize="16" />
                                    <DatePicker  materialDesign:HintAssist.Hint="من ..." Width="160" Height="40" Background="White" FontFamily="Tajawal" FontSize="14" BorderThickness="2"/>
                                    <TextBlock Text="من تاريخ  :" Margin="46,14,20 14" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" FontSize="16" />
                                    <DatePicker  materialDesign:HintAssist.Hint="من ..." Width="160" Height="40" Background="White" FontFamily="Tajawal" FontSize="14" BorderThickness="2"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="panel_Decument" Visibility="Hidden" Grid.Column="1" Background="White"></StackPanel>
                        </Grid>
                    </StackPanel>
                
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Background="White" Orientation="Horizontal"  FlowDirection="RightToLeft">

            <DataGrid Name="grid_view" Visibility="Hidden" Style="{StaticResource Style_Datagrid}" Margin="10 5 5 5" ItemsSource="{Binding Items3}" 
                          materialDesign:DataGridAssist.CellPadding="1 5 8 8" materialDesign:DataGridAssist.ColumnHeaderPadding="8" MaxWidth="1200" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Height="340"    >

                <DataGrid.Columns>

                    <DataGridTextColumn Binding="{Binding Code}"
                                        Header="رقم السند" MinWidth="100"
                                         />
                    <DataGridTextColumn Binding="{Binding Code}"
                                        Header="تاريخ السند" MinWidth="110"
                                         />
                    <!--if you want to use the pop up style (MaterialDesignDataGridTextColumnPopupEditingStyle), you must use MaterialDataGridTextColumn-->
                    <materialDesign:DataGridTextColumn Binding="{Binding Name}"
                                                           Header="من حساب"  MinWidth="80"
                                                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}" 
                                                           />
                    <!-- set a max length to get an indicator in the editor -->
                    <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="رقم الحساب"
                                                       MinWidth="80"
                                                           MaxLength="255" 
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />

                    <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="الى حساب"  MinWidth="80"
                                                          
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="رقم الحساب " MinWidth="80"
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="المبلغ " MinWidth="80"
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                             Header="البيان"  MinWidth="250"
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />

                    <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="تاريخ الترحيل " MinWidth="100"
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                                EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"
                                                MinWidth="100" MaxWidth="100" Header="الغاء الترحيل">

                    </DataGridCheckBoxColumn>

                    <!-- use custom combo box column to get better combos. Use ItemsSourceBinding as your binding template to be applied to each combo -->

                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>
    </Grid>
</UserControl>
