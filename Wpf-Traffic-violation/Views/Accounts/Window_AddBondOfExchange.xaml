<Window x:Class="Wpf_Traffic_violation.Views.Window_AddBondOfExchange"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
        mc:Ignorable="d"
        Title="Window_AddBondOfExchange" Height="679" Width="860" FlowDirection="RightToLeft" BorderThickness="1" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" BorderBrush="#FFDD2C00" WindowStyle="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="263"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Background="WhiteSmoke" Height="263" Width="860" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <!--/////////////////////////////////////////Top/////////////////////////////////////////////////-->
        <materialDesign:ColorZone DockPanel.Dock="Top" Background="OrangeRed">
            <StackPanel Orientation="Horizontal" Height="30" >

                <materialDesign:PackIcon Kind="Add" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="5 0 0 0"></materialDesign:PackIcon>
                <TextBlock Text=" بيانات سند صرف  " HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Tajawal" FontWeight="Bold" Foreground="White"/>
                    <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" HorizontalAlignment="Right" x:Name="But_close"  Width="30" Height="30" Foreground="Wheat" Background="{x:Null}" BorderBrush="{x:Null}" Command="{Binding Closecommand}" Padding="0" Margin="680,0,0,0" >
                    <materialDesign:PackIcon  Kind="Close" Width="24" Height="24" VerticalAlignment="Bottom"    />
                </Button>
            </StackPanel>
        </materialDesign:ColorZone>
        <!--///////////////////////////////////////////Bottom///////////////////////////////////////////////-->

        
        <!--/////////////////////////////////////////////Center/////////////////////////////////////////////-->
        
           
            <Grid FlowDirection="RightToLeft"  >
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Tajawal"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Foreground" Value="#022551"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                

            </Grid.RowDefinitions>
          

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text=" رقم سند الصرف :" Margin="15 0 15 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    <TextBox  Text="{Binding Current_BondOfExchange.Bond_Exchange_id}"  x:Name="textBox"   Height="40" Width="240"
                       IsEnabled="False" Background="White"
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False"  Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="تاريخ السند :"  Margin="40 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    <DatePicker SelectedDate="{x:Static sys:DateTime.Now}" Text="{Binding Current_BondOfExchange.Bond_Exchange_date,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" 
                                
                                Width="240" Height="40" Background="White" Foreground="Black" FontFamily="Tajawal" FontSize="16" BorderThickness="1" />


                </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <TextBlock Text=" من الحساب :" Margin="15 0 15 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    <ComboBox Width="240" Height="40" ItemsSource="{Binding Grid_Account}" SelectedItem="{Binding Selected_AccountFrom}"
                          
                          materialDesign:TextFieldAssist.UnderlineBrush="{DynamicResource SecondaryAccentBrush}"
                          materialDesign:ColorZoneAssist.Mode="Standard"
                              materialDesign:HintAssist.Hint="أسم الحساب"
                          
                          Padding="10,10,0,0" Background="White" Foreground="Black" Margin="0,9" FontFamily="Tajawal" FontSize="14" BorderThickness="1">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Account_name ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>
                <TextBlock Text="رقم الحساب :"  Margin="30 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    <TextBox   Text="{Binding Selected_AccountFrom.Account_id}"  Height="40" Width="240" IsEnabled="False"
                        materialDesign:HintAssist.Hint="رقم الحساب..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"   Background="White"  Margin="10  0 9 0" FontFamily="Tajawal" FontSize="14" />


            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock Text=" الى الحساب :" Margin="15 0 15 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    <ComboBox Width="240" Height="40" ItemsSource="{Binding Grid_Account}" SelectedItem="{Binding Selected_AccountTo}"
                         
                          materialDesign:TextFieldAssist.UnderlineBrush="{DynamicResource SecondaryAccentBrush}"
                          materialDesign:ColorZoneAssist.Mode="Standard"
                          materialDesign:HintAssist.Hint="أسم الحساب"
                          Padding="10,10,0,0" Background="White"  Margin="0,9" FontFamily="Tajawal" FontSize="14" BorderThickness="1">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Account_name ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>
                    <TextBlock Text="رقم الحساب :"  Margin="30 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    <TextBox  Text="{Binding Selected_AccountTo.Account_id}"   Height="40" Width="240" IsEnabled="False"
                        materialDesign:HintAssist.Hint="رقم الحساب..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White"  Margin="10  0 9 0" FontFamily="Tajawal" FontSize="14" />


            </StackPanel>
           
            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <TextBlock Text="رقم المرجع :" Margin="18 0 033 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                    <TextBox  Text="{Binding Current_BondOfExchange.Reference_number}"     Height="40" Width="240"
                        materialDesign:HintAssist.Hint="رقم المرجع..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="بيان المرجع :" Margin="30 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    <TextBox   Text="{Binding Current_BondOfExchange.Bond_Exchange_statement}"    Height="40" Width="240"
                        materialDesign:HintAssist.Hint="بيان المرجع..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="10  0 9 0" FontFamily="Tajawal" FontSize="14" />

            </StackPanel>


        </Grid>

     

        <!--نستحدم الفريم هذا أذا كنا نشتي نستخدم يوزركنترول-->
        <!--<Frame x:Name="Frame_Window" NavigationUIVisibility="Hidden" Width="1300" Height="270"></Frame>-->
    </DockPanel>
        <Grid Grid.Row="1" Height="58" Background="#5B7C99" HorizontalAlignment="Left" Width="858">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Tajawal"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </Grid.Resources>
            <StackPanel  Orientation="Horizontal">
                <TextBlock Text="المبلغ :" Margin="18 0 033 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox   Text="{Binding Current_Bond_Exchange_detail.Bond_Exchange_detail_amount}"    Height="40" Width="240"
                        materialDesign:HintAssist.Hint="المبلغ..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
             
                <TextBlock Text="البيان :" Margin="33 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120"/>
                <TextBox   Text="{Binding Current_Bond_Exchange_detail.Bond_Exchange_detail_statement}"    Height="40" Width="240"
                        materialDesign:HintAssist.Hint="البيان..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="7  0 05 0" FontFamily="Tajawal" FontSize="14" />
                <Button Width="24" Height="24" Padding="0" Margin="0 0 5 0" Command="{Binding AddDetailcommand}" >
                    <materialDesign:PackIcon  Kind="ArrowBottom" Width="24" Height="24" Padding="0" VerticalAlignment="Bottom"  />
                </Button>
                <Button Width="24" Height="24" Padding="0" Command="{Binding DeletDetailcommand}">
                    <materialDesign:PackIcon  Kind="ArrowTop" Width="24" Height="24" Padding="0" VerticalAlignment="Bottom"  />
                </Button>
            </StackPanel>
          
        </Grid>
        <DataGrid Grid.Row="2" HorizontalAlignment="Center" Style="{StaticResource Style_Datagrid}" ItemsSource="{Binding Grid_Bond_Exchange_detail}"   SelectedItem="{Binding Current_Bond_Exchange_detail}"
                          materialDesign:DataGridAssist.CellPadding="1 5 8 8" materialDesign:DataGridAssist.ColumnHeaderPadding="8" 
                          >
           
            <DataGrid.Columns>

                <DataGridTextColumn Binding="{Binding Bond_Exchange_detail_amount}"
                                        Header="المبلغ" MinWidth="200"
                                         />
                <!--if you want to use the pop up style (MaterialDesignDataGridTextColumnPopupEditingStyle), you must use MaterialDataGridTextColumn-->
                <DataGridTextColumn Binding="{Binding Bond_Exchange_detail_statement}"
                                                           Header="البيان"  MinWidth="600"
                                                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}" 
                                                           />
                





                <!-- use custom combo box column to get better combos. Use ItemsSourceBinding as your binding template to be applied to each combo -->

            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Background="#5B7C99">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Tajawal"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </Grid.Resources>
            
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Background="#5B7C99" Height="58" HorizontalAlignment="Center"  >
                <TextBlock Text="إجمالي المبلغ ="  FontFamily="Tajawal" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="20 0 20 0"/>
                <TextBox   Text="{Binding Current_BondOfExchange.Bond_Exchange_amount}"    Height="40" Width="200"
                        materialDesign:HintAssist.Hint="إجمالي المبلغ ..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />

                <Button Height="40" Width="100" Margin="40 0 10 0"  Padding="0" Command="{Binding Savecommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <materialDesign:PackIcon Kind="AttachMoney" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Text="حفظ" VerticalAlignment="Center" FontFamily="Tajawal" FontSize="18" Padding="5 2 0 2"/>
                    </StackPanel>
                </Button>
                <Button Height="40" Width="100" Margin="10 0"  Padding="0" Background="#022551">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <materialDesign:PackIcon Kind="Printer" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Text="طباعة" VerticalAlignment="Center" FontFamily="Tajawal" FontSize="18" Padding="5 2 0 2"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        
        </Grid>
    </Grid>
</Window>
