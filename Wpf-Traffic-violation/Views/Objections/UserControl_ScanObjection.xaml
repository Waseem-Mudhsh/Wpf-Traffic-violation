<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_ScanObjection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ViewModel="clr-namespace:Wpf_Traffic_violation.ViewModel"
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
             mc:Ignorable="d" 
            d:DesignHeight="560" d:DesignWidth="1360">
    <UserControl.DataContext>
        <ViewModel:OpjectionViewModel/>
    </UserControl.DataContext>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderThickness="0 0 0 1" BorderBrush="Blue">
            <StackPanel  Height="60" Background="WhiteSmoke" Orientation="Horizontal" >

                <!--top-->

                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="150 0" FlowDirection="RightToLeft" >
                    <Button  Height="40" Width="40" Padding="0" Background="OrangeRed" VerticalAlignment="Center" HorizontalAlignment="Center"  materialDesign:ShadowAssist.ShadowDepth="Depth0" BorderBrush="{x:Null}">
                        <materialDesign:PackIcon Kind="Search" Width="32" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"></materialDesign:PackIcon>
                    </Button>
                    <controls:AutoCompleteBox Name="aa" Width="338" ItemsSource="{Binding Grid_Opjection}" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="20 8 0 5"
                                              ValueMemberPath="Search" 
                                              SelectedItem="{Binding Currunt_Opjection , Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" FilterMode="Contains" Margin="4,1,4,0"
                                             
                                          />
                </StackPanel>

                <Button   x:Name="But_Scan_Objection" Command="{Binding Scancommand}"  Margin="560,0,10,0" Background="#FF097221"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center"  Width="80" BorderBrush="#FF097221" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">فحص</TextBlock>
                        <materialDesign:PackIcon Kind="ScanHelper" Margin="5 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>


            </StackPanel>

        </Border>
        <StackPanel  Background="White" >

            <DataGrid Style="{StaticResource Style_Datagrid}" Margin="10 5 5 5" ItemsSource="{Binding Grid_Opjection}"  SelectedItem="{Binding Currunt_Opjection}"
                          materialDesign:DataGridAssist.CellPadding="1 5 8 8" Height="480" materialDesign:DataGridAssist.ColumnHeaderPadding="8" MaxWidth="1300" HorizontalAlignment="Right"
                          >
                <DataGrid.Resources>

                </DataGrid.Resources>
                <DataGrid.Columns>

                    <DataGridTextColumn Binding="{Binding Interception_id}"
                                        Header="رقم الإعتراض" MinWidth="100"
                                         />
                    <DataGridTextColumn Binding="{Binding Interception_date}"
                                        Header="تاريخ الإعتراض" MinWidth="100"
                                         />
                    <materialDesign:DataGridTextColumn Binding="{Binding String_Ciziten}"
                                                        Header="أسم المعترض"  MinWidth="200"
                                                        
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}" MaxWidth="300">


                    </materialDesign:DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Violation_id}"
                                        Header="رقم المخالفة" MinWidth="100"
                                         />
                    <materialDesign:DataGridTextColumn Binding="{Binding Reason_Interception}"
                                                        Header="سبب الإعتراض"  MinWidth="300"
                                                        
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}" MaxWidth="300">


                    </materialDesign:DataGridTextColumn>

                    <materialDesign:DataGridTextColumn Binding="{Binding String_Status}"
                                        Header="الحالة" MinWidth="100"
                                                 EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}" MaxWidth="150">


                    </materialDesign:DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</UserControl>
