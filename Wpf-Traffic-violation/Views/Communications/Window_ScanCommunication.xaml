<Window x:Class="Wpf_Traffic_violation.Views.Window_ScanCommunication"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
        mc:Ignorable="d"
        Title="Window_ScanCommunication" Height="358" Width="1200" FlowDirection="RightToLeft" BorderThickness="1" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" BorderBrush="#FFDD2C00" WindowStyle="None" ScrollViewer.VerticalScrollBarVisibility="Disabled"  ResizeMode="NoResize">
    <DockPanel Background="WhiteSmoke" Height="358" Width="1200" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <!--/////////////////////////////////////////Top/////////////////////////////////////////////////-->
        <materialDesign:ColorZone DockPanel.Dock="Top" Background="OrangeRed">
            <StackPanel Orientation="Horizontal" Height="30" >

                <materialDesign:PackIcon Kind="Add" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"></materialDesign:PackIcon>
                <TextBlock Text="فحص بيانات بلاغ" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Tajawal" FontWeight="Bold" Foreground="White"/>
                <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" HorizontalAlignment="Right" x:Name="But_close"  Width="30" Height="30" Foreground="Wheat" Background="{x:Null}" BorderBrush="{x:Null}"  Click="But_close_Click" Padding="0" Margin="1040,0,0,0" >
                    <materialDesign:PackIcon  Kind="Close" Width="24" Height="24" VerticalAlignment="Bottom"    />
                </Button>
            </StackPanel>
        </materialDesign:ColorZone>
        <!--///////////////////////////////////////////Bottom///////////////////////////////////////////////-->

        <Grid DockPanel.Dock="Bottom" Height="40">
            <Button Content=" حفــظ" Command="{Binding Savecommand}"></Button>
        </Grid>
        <!--/////////////////////////////////////////////Center/////////////////////////////////////////////-->
        <Grid FlowDirection="RightToLeft" >

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Tajawal"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Foreground" Value="#022551"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="793*"/>
                <ColumnDefinition Width="407*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="رقم البلاغ :" Margin="15 0 030 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox    x:Name="textBox" Text="{Binding Current_Communication.Communication_id,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  Height="40" Width="240" IsEnabled="False"
                        materialDesign:HintAssist.Hint="رقم البلاغ..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="تفصيل البلاغ :" Margin="25 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox      Height="40" Width="240" Text="{Binding Current_Communication.Communication_name,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" IsEnabled="False"
                        materialDesign:HintAssist.Hint="..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="التاريخ:" Margin="35 0 30 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox      Height="40" Width="240" IsEnabled="False" Text="{Binding Current_Communication.Communication_date,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                        
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="  رقم اللوحة :" Margin="5 0 028 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>

                <TextBox  Text="{Binding Selected_Plate.Plate_num,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"    Height="40" Width="174.865" IsEnabled="False"
                        materialDesign:HintAssist.Hint="رقم اللوحة..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="12 9 0 9" FontFamily="Tajawal" FontSize="14" />
                <TextBox Text="{Binding Selected_Plate.Province_id,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"     Height="40" Width="53.684" IsEnabled="False"
                        
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="12 9 0 9" FontFamily="Tajawal" FontSize="14" />

                <TextBlock Text="نوع اللوحة :" Margin="25 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->
                <TextBox   Text="{Binding Selected_Plate.String_Plate_type,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"   Height="40" Width="240" IsEnabled="False"
                        materialDesign:HintAssist.Hint="نوع اللوحة..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="مكان البلاغ :" Margin="32 0 32 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox   Text="{Binding   Current_Communication.Communication_place,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"    Height="40" Width="240" IsEnabled="False"
                        materialDesign:HintAssist.Hint="مكان البلاغ..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />

            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="أسم المبلغ  :" Margin="18 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>

                <TextBox   Text="{Binding  Current_Communication.String_Ciziten,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"   Height="40" Width="240" IsEnabled="False"
                        materialDesign:HintAssist.Hint="أسم المبلغ..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="3 9 0 9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="رقم الهوية :" Margin="25 0 24 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox  Text="{Binding   Current_Communication.Citizen_id,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"     Height="40" Width="240" IsEnabled="False"
                        materialDesign:HintAssist.Hint="رقم الهوية..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="01 9 0 9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="الصور :" Margin="35 0 30 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBlock Text="الصورة 1" FontWeight="Medium" Margin="25 0 30 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBlock Text="الصورة 2" FontWeight="Medium" Margin="15 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>

            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Grid.ColumnSpan="2">

                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->

            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="ملاحظة  :" Margin="18 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>

                <TextBox   Text="{Binding   Current_Communication.Communication_notice,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"   Height="40" Width="633" IsEnabled="False"
                        materialDesign:HintAssist.Hint="الملاحظة..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="3 9 0 9" FontFamily="Tajawal" FontSize="14" />
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->

            </StackPanel>
            <Border  BorderThickness="2" BorderBrush="LightBlue" materialDesign:ShadowAssist.ShadowDepth="Depth2" Grid.RowSpan="3" Grid.Column="1" Background="White" Height="100" Margin="145,6,143,10" Grid.Row="3" >
                <StackPanel  >
                    <Image x:Name="logo1" Stretch="Fill"/>
                </StackPanel>
            </Border>
            <Border  Margin="265 0 0 2" BorderThickness="2" BorderBrush="LightBlue" materialDesign:ShadowAssist.ShadowDepth="Depth2" Grid.RowSpan="3" Grid.Column="1" Background="White" Height="100" Width="116" Grid.Row="3" >
                <StackPanel  >
                    <Image x:Name="logo2" Stretch="Fill"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Grid.Row="4">
                <TextBlock Text="الحالة  :" Margin="18 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <RadioButton x:Name="RadioButton1"  Style="{StaticResource MaterialDesignAccentRadioButton}" Content="قبول   " Click="RadioButton_True_Click"  FontFamily="Tajawal" FontSize="16" FontWeight="Bold" Margin="0 0 10 0"/>
                <RadioButton x:Name="RadioButton2" Style="{StaticResource MaterialDesignAccentRadioButton}"  Content="رفض " Click="RadioButton_False_Click" FontFamily="Tajawal" FontSize="16" FontWeight="Bold" Margin="10 0 0 0"/>
                <Button x:Name="but_AddViolation" Width="115" Height="40"  Margin="80 9 0 9" Padding="0" Visibility="Hidden" Command="{Binding Addviolationcommand}" >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" >
                        <TextBlock Foreground="White"  VerticalAlignment="Center"  ><Run Text="إضافة مخالفة"/></TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>

        </Grid>
        <!--نستحدم الفريم هذا أذا كنا نشتي نستخدم يوزركنترول-->
        <!--<Frame x:Name="Frame_Window" NavigationUIVisibility="Hidden" Width="1300" Height="270"></Frame>-->
    </DockPanel>
</Window>
