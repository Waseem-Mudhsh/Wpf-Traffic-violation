<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_CommunicationOperation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ViewModel="clr-namespace:Wpf_Traffic_violation.ViewModel"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="1360">
    <UserControl.DataContext>
        <ViewModel:Communication_ViewModel/>
    </UserControl.DataContext>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderThickness="0 0 0 1" BorderBrush="Blue">
            <StackPanel  Height="60" Background="WhiteSmoke" Orientation="Horizontal" >

                <!--top-->

                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="125 0" FlowDirection="RightToLeft" >
                    <Button  Height="40" Width="40" Padding="0" Background="OrangeRed" VerticalAlignment="Center" HorizontalAlignment="Center"  materialDesign:ShadowAssist.ShadowDepth="Depth0" BorderBrush="{x:Null}">
                        <materialDesign:PackIcon Kind="Search" Width="32" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"></materialDesign:PackIcon>
                    </Button>
                    <controls:AutoCompleteBox Width="400" ItemsSource="{Binding Grid_Communication }" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="20 8 0 5" 
                                              ValueMemberPath="Search" 
                                              SelectedItem="{Binding Current_Communication , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FilterMode="Contains"
                                              />
                </StackPanel>

                <Button  x:Name="But_Delete_Communication"  Command="{Binding Deletecommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Width="80" Margin="390,0,0,0" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">حذف</TextBlock>
                        <materialDesign:PackIcon Kind="Delete" Margin="5 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button  x:Name="But_Edit_Communication"  Command="{Binding Editcommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0" Width="80" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">تعديل</TextBlock>
                        <materialDesign:PackIcon Kind="Edit" Margin="5 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>
                <Button  x:Name="But_Add_Communication" Command="{Binding Addcommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0" Width="80" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">إضافة</TextBlock>
                        <materialDesign:PackIcon Kind="Add" Margin="5 0 0 0" Width="24" Height="24" />
                    </StackPanel>
                </Button>

            </StackPanel>

        </Border>
        <StackPanel  Background="White" >

            <DataGrid Style="{StaticResource Style_Datagrid}" Margin="10 5 5 5" ItemsSource="{Binding Grid_Communication}"  SelectedItem="{Binding Current_Communication,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                          MaxWidth="1300" HorizontalAlignment="Right" Height="480"
                          >
                <DataGrid.Columns>

                    <DataGridTextColumn Binding="{Binding Communication_id}"
                                        Header="رقم البلاغ" MinWidth="100"
                                         />
                    <DataGridTextColumn Binding="{Binding Communication_name}"
                                                        Header="البلاغ " MinWidth="300" MaxWidth="300"/>
                    <DataGridTextColumn Binding="{Binding Communication_date}"
                                        Header="تاريخ البلاغ" MinWidth="100"
                                         />
                    <DataGridTextColumn Binding="{Binding PlateNum}"
                                                        Header="رقم اللوحة"  MinWidth="100"
                                        MaxWidth="300"/>


                    <DataGridTextColumn Binding="{Binding Communication_place}"
                                        Header="مكان البلاغ" MinWidth="100"
                                         />
                    <DataGridTextColumn Binding="{Binding String_Ciziten}"
                                                        Header="أسم المبلغ " MinWidth="300" MaxWidth="300"/>
                    <DataGridTextColumn Binding="{Binding String_Status}"
                                                        Header=" الحالة" MinWidth="300" MaxWidth="150"/>
                    <!--<DataGridTextColumn Binding="{Binding Communication_photo1}" Visibility="Hidden"
                                                        MinWidth="300" MaxWidth="300"/>
                    <DataGridTextColumn Binding="{Binding Communication_photo1}" Visibility="Hidden"
                                                        MinWidth="300" MaxWidth="150"/>-->


                    <!--if you want to use the pop up style (MaterialDesignDataGridTextColumnPopupEditingStyle), you must use MaterialDataGridTextColumn-->

                    <!-- set a max length to get an indicator in the editor -->






                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</UserControl>