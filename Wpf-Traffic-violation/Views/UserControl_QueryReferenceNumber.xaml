<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_QueryReferenceNumber"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="512" d:DesignWidth="1360">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderThickness="0 1" BorderBrush="OrangeRed">
            <StackPanel   Height="50"  Orientation="Horizontal" FlowDirection="RightToLeft" Background="White" >
                <TextBlock Text="رقم المرجعية :" Margin="30 0 15 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="90" FontFamily="Tajawal" FontSize="14" FontWeight="Bold"/>

                <TextBox     Height="40" Width="225"
                        materialDesign:HintAssist.Hint="رقم المرجعية..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="#eceff1" Margin="0,5" FontFamily="Tajawal" FontSize="14" />


                <Button Width="40" Height="40" Padding="0" Background="OrangeRed" materialDesign:ShadowAssist.ShadowDepth="Depth1" Margin="20 0 0 0" >
                    <materialDesign:PackIcon Kind="Search" Foreground="White"  Width="24" Height="24" HorizontalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>
        <DockPanel  Background="#f5f5f5" >
            <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Width="340">
                <!--////////////////////////////////////////////////////////////////////-->
                <StackPanel Margin="10" >
                    <materialDesign:ColorZone Height="40" Mode="PrimaryDark">
                        <TextBlock Text="نتائج الأستعلام" FontFamily="Tajawal" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"/>
                    </materialDesign:ColorZone>
                    <!--///////////////////////////////////////////////////////////////////////////////////////-->
                    <Border Height="60" BorderThickness="1 0 1 1" BorderBrush="DodgerBlue">
                        <StackPanel  Background="White" FlowDirection="RightToLeft" >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="عدد المخالفات الغير مدفوعة :" FontSize="14" FontWeight="Bold" Foreground="Gray" Margin="5"/>
                                <TextBlock Text="10" FontSize="14" FontWeight="Bold" Foreground="Black" Margin="15 5 5 5"/>
                            </StackPanel>
                            <!--..................................................................................-->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="أجمالي المبلغ المطلوب :" FontSize="14" FontWeight="Bold" Foreground="Gray" Margin="5"/>
                                <TextBlock Text="10" FontSize="14" FontWeight="Bold" Foreground="Black" Margin="15 5 5 5"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                    <!--///////////////////////////////////////////////////////////////////////////////////////-->
                </StackPanel>
                <!--////////////////////////////////////////////////////////////////////-->

            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Height="400">
                <DataGrid Margin="10" Style="{StaticResource Style_Datagrid}"  ItemsSource="{Binding Items3}" 
                          materialDesign:DataGridAssist.CellPadding="1 5 8 8" materialDesign:DataGridAssist.ColumnHeaderPadding="8" MaxWidth="1300" HorizontalAlignment="Right"
                          >
                    <DataGrid.Resources>

                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                                EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}">
                            <DataGridCheckBoxColumn.Header>
                                <!--padding to allow hit test to pass thru for sorting -->
                                <Border Background="Transparent" Padding="6 0 6 0" HorizontalAlignment="Center">
                                    <CheckBox HorizontalAlignment="Center"
                                               />
                                </Border>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Binding="{Binding Code}"
                                        Header="رقم المرجعية" MinWidth="80"
                                         />
                        <!--if you want to use the pop up style (MaterialDesignDataGridTextColumnPopupEditingStyle), you must use MaterialDataGridTextColumn-->
                        <materialDesign:DataGridTextColumn Binding="{Binding Name}"
                                                           Header="رقم اللوحة"  MinWidth="80"
                                                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}" 
                                                           />
                        <materialDesign:DataGridTextColumn Binding="{Binding Name}"
                                                           Header="تاريخ المخالفة"  MinWidth="80"
                                                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}" 
                                                           />
                        <!-- set a max length to get an indicator in the editor -->

                        <materialDesign:DataGridTextColumn Binding="{Binding Numeric}"
                                                        Header="نوع المخالفة"  MinWidth="150"
                                                        
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding}" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </materialDesign:DataGridTextColumn>
                        <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="المكان "  MinWidth="80"
                                                          
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                        <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="المبلغ"  MinWidth="80"
                                                           
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                        <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="الغرامة " MinWidth="80"
                                                            
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                        <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="بواسطة"  MinWidth="100"
                                                           MaxLength="255" 
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                        <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="ملاحظة"  MinWidth="80"
                                                           MaxLength="255" 
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />





                        <!-- use custom combo box column to get better combos. Use ItemsSourceBinding as your binding template to be applied to each combo -->

                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top">
                <Border  BorderThickness="1" BorderBrush="Black"  HorizontalAlignment="Center"  Margin="4 1 4 0">
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Background="White" Height="50" HorizontalAlignment="Center" >
                        <TextBlock Text="إجمالي المبلغ =" Foreground="DodgerBlue" FontFamily="Tajawal" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="20 0 20 0"/>
                        <Border Width="130" Height="40"  BorderThickness="1" BorderBrush="Black" >
                            <TextBlock Text="1200000000" FontFamily="Tajawal" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="المبلغ المحدد =" Foreground="DodgerBlue" FontFamily="Tajawal" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="30 0 20 0"/>
                        <Border Width="130" Height="40"  BorderThickness="1" BorderBrush="Black"  Margin="0 0 20 0">
                            <TextBlock Text="12000" FontFamily="Tajawal" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Button x:Name="but_PayViolation" Height="40" Width="100" Margin="10 0"  Padding="0"  Click="but_PayViolation_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <materialDesign:PackIcon Kind="AttachMoney" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Text="تسديد" VerticalAlignment="Center" FontFamily="Tajawal" FontSize="18" Padding="5 2 0 2"/>
                            </StackPanel>
                        </Button>
                        <Button Height="40" Width="100" Margin="10 0"  Padding="0" Background="#022551">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <materialDesign:PackIcon Kind="Printer" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Text="طباعة" VerticalAlignment="Center" FontFamily="Tajawal" FontSize="18" Padding="5 2 0 2"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

        </DockPanel>
    </DockPanel>
</UserControl>
