<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_NotificationSystem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             mc:Ignorable="d" 
              d:DesignHeight="560" d:DesignWidth="1360">
   
    <DockPanel Background="White">
        <Border DockPanel.Dock="Top" Margin="5" BorderThickness="1" BorderBrush="DarkOrange">
        <Grid FlowDirection="RightToLeft"   Background="#FFF5F5F5" Height="150"  >

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Tajawal"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="#022551"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Width" Value="200"/>
                    <Setter Property="BorderThickness" Value="0 0 0 02"/>
                        


                    </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="61*"/>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="208"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="أسم النظام :" Margin="15 0 030 0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBox    x:Name="textBox"  
                        materialDesign:HintAssist.Hint="أسم النظام..."
                          Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="المجال :" Margin="15 0 15 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->
                <TextBox      
                        materialDesign:HintAssist.Hint="الأسم المختصر..."
                          Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="2 0 0 0" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="الإيميل :" Margin="11 0 22 0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBox    x:Name="textBox1"  
                        materialDesign:HintAssist.Hint="المجال ..."
                          Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" FontFamily="Tajawal" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="العنوان :" Margin="15 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="77"/>
                <TextBox     
                        materialDesign:HintAssist.Hint="العنوان..."
                          Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="05 9 0 9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="تلفون :" Margin="14 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="91"/>
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->
                <TextBox      
                        materialDesign:HintAssist.Hint="الإيميل..."
                          Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />


            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" >
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->
            </StackPanel>
            <StackPanel  Grid.Column="1" Grid.RowSpan="3" >
                <Button  Width="145" Height="34" x:Name="but_SelectLogo" Click="but_SelectLogo_Click" Margin="5"  HorizontalAlignment="Left" >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="123">
                        <materialDesign:PackIcon Kind="Select"   Width="24" Height="24"    HorizontalAlignment="Center"/>
                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="10 2 2 2 " >تحديد شعار</TextBlock>
                    </StackPanel>
                </Button>
                <Border  Width="145" Height="100"   BorderThickness="2" BorderBrush="LightBlue" materialDesign:ShadowAssist.ShadowDepth="Depth2" Background="White" HorizontalAlignment="Left" Margin="5 0" >
                    <StackPanel Orientation="Vertical"   >
                        <Image x:Name="logo" Width="145" Height="100" Stretch="Fill" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel  Grid.Column="2" Grid.RowSpan="3" >
                <Button Name="But_save" IsEnabled="{Binding ElementName=But_edit, Path=IsEnabled}" Width="100" Height="34"   Margin="0 30 0 10"  HorizontalAlignment="Center" >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="75">
                        <materialDesign:PackIcon Kind="ContentSave"   Width="24" Height="24"    HorizontalAlignment="Center"/>
                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="10 2 2 2 " >حفظ</TextBlock>
                    </StackPanel>
                </Button>
                    <Button Name="But_edit" IsEnabled="True" Width="100" Height="34"   Margin="5"  HorizontalAlignment="Center" >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="75" >
                        <materialDesign:PackIcon Kind="Edit"   Width="24" Height="24"    HorizontalAlignment="Center"/>
                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="10 2 2 2 " >تعديل</TextBlock>
                    </StackPanel>

                </Button>
            </StackPanel>
        </Grid>
        </Border>
        <!--///////////////////////////////////////////////////////////////////////////////////////-->
        <materialDesign:ColorZone DockPanel.Dock="Top" Background="OrangeRed" Margin="0 1 05 1" Width="565" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" Height="40" FlowDirection="RightToLeft" >

                <TextBlock Text="خصائص النظام " HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Tajawal" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </materialDesign:ColorZone>


        <Grid Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="2" FlowDirection="RightToLeft" Margin="0 2 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderThickness="1" BorderBrush="LightSlateGray" Margin="05 0 0 0">
                    <StackPanel Grid.Row="0"  Orientation="Horizontal" >
                        <TextBlock   Text="- تنبية بالنسخة الإحتياطية كل " VerticalAlignment="Center" FontSize="16" Margin="10 0" Width="192"/>
                        <RadioButton x:Name="RadioButton_day"  Style="{StaticResource MaterialDesignAccentRadioButton}" Content="يوم  "  FontFamily="Tajawal" FontSize="16" FontWeight="Bold" Margin="1 0 1 0"/>
                        <RadioButton x:Name="RadioButton_Week"  Style="{StaticResource MaterialDesignAccentRadioButton}" Content="أسبوع  "  FontFamily="Tajawal" FontSize="16" FontWeight="Bold" Margin="1 0 1 0"/>
                        <RadioButton x:Name="RadioButton_Month"  Style="{StaticResource MaterialDesignAccentRadioButton}" Content="شهر  "  FontFamily="Tajawal" FontSize="16" FontWeight="Bold" Margin="1 0 1 0"/>
                        <RadioButton x:Name="RadioButton_Not"  Style="{StaticResource MaterialDesignAccentRadioButton}" Content="عدم التنبية  "  FontFamily="Tajawal" FontSize="16" FontWeight="Bold" Margin="3 0 10 0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" BorderThickness="1" BorderBrush="LightSlateGray" Margin="05 0 0 0">
                    <StackPanel   Orientation="Horizontal">
                        <TextBlock   Text="- التنبية عند" VerticalAlignment="Center" FontSize="16" Margin="10 0" Width="192"/>
                        <RadioButton x:Name="RadioButton_day1"  Style="{StaticResource MaterialDesignAccentRadioButton}" Content="دخول النظام  "  FontFamily="Tajawal" FontSize="16" FontWeight="Bold" Margin="1 0 13 0"/>

                        <RadioButton x:Name="RadioButton_Not1"  Style="{StaticResource MaterialDesignAccentRadioButton}" Content="خروج النظام  "  FontFamily="Tajawal" FontSize="16" FontWeight="Bold" Margin="3 0 10 0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" BorderThickness="1" BorderBrush="LightSlateGray" Margin="05 0 0 0">
                    <StackPanel Grid.Row="2"  Orientation="Horizontal">
                        <CheckBox x:Name="ClickBox_Rank" IsChecked="False" Style="{StaticResource MaterialDesignDarkCheckBox}" Content="تحديد الرتبة" FontFamily="Tajawal" FontSize="16" Margin="10 0" Width="192" BorderThickness="2"/>
                        <TextBox Width="100" VerticalAlignment="Center" Height="40" BorderThickness="1" FontSize="16" FontFamily="Tajawal" Padding="4 1 0 0" IsEnabled="{Binding ElementName=ClickBox_Rank, Path=IsChecked}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="3" BorderThickness="1" BorderBrush="LightSlateGray" Margin="05 0 0 0">
                    <StackPanel  Orientation="Horizontal">
                        <CheckBox x:Name="ClickBox_show" IsChecked="False" Style="{StaticResource MaterialDesignDarkCheckBox}" Content="إظهار البلاغات بالشاشة الرئيسية" FontFamily="Tajawal" FontSize="16" Margin="10 0"  BorderThickness="2"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="4" BorderThickness="1" BorderBrush="LightSlateGray" Margin="05 0 0 0">
                    <StackPanel  Orientation="Horizontal">
                        <CheckBox x:Name="ClickBox_show1" IsChecked="False" Style="{StaticResource MaterialDesignDarkCheckBox}" Content="إظهار الإعتراضات بالشاشة الرئيسية" FontFamily="Tajawal" FontSize="16" Margin="10 0"  BorderThickness="2"/>
                    </StackPanel>
                </Border>

            </Grid>


        </Grid>



    </DockPanel>
</UserControl>
