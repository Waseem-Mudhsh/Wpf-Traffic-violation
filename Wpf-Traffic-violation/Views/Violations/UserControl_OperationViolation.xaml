<UserControl x:Class="Wpf_Traffic_violation.Views.UserControl_OperationViolation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ViewModel="clr-namespace:Wpf_Traffic_violation.ViewModel"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="560" Width="1360">
    <UserControl.DataContext>
        <ViewModel:ViolationViewModel/>
    </UserControl.DataContext>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderThickness="0 0 0 1" BorderBrush="Blue">
            <StackPanel  Height="60" Background="WhiteSmoke" Orientation="Horizontal" HorizontalAlignment="Left" Width="1360" >

                <!--top-->

                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="30 0" FlowDirection="RightToLeft" >
                    <controls:AutoCompleteBox Width="200" ItemsSource="{Binding Grid_Violation }" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="10 8 0 5" 
                                              ValueMemberPath="Search" Margin="2 0"
                                              SelectedItem="{Binding Current_Violation , Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" FilterMode="Contains"
                                              />
                    <Button  Height="40" Width="40" Padding="0" Background="OrangeRed" VerticalAlignment="Center" HorizontalAlignment="Center"
                           materialDesign:ShadowAssist.ShadowDepth="Depth0" BorderBrush="{x:Null}">
                        <materialDesign:PackIcon Kind="Search" Width="32" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"></materialDesign:PackIcon>
                    </Button>
                  
                </StackPanel>
                <Button  Command="{Binding Excelcommand}"
                                   Height="40"       Uid="7"  x:Name="but1" Padding="0" Margin="5,0,20,0" Background="#FF097221" BorderBrush="{x:Null}" Width="150" >
                    <StackPanel Orientation="Horizontal" Margin="12 0 12 0" HorizontalAlignment="Center">
                        <TextBlock  VerticalAlignment="Center">إستيراد من أكسل</TextBlock>
                        <materialDesign:PackIcon Kind="FileExcel" Margin="8 0 0 0" Width="24" Height="24" HorizontalAlignment="Right" />
                    </StackPanel>
                </Button>
                <Button  Height="40" Width="40" Padding="0" Background="OrangeRed" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Command="{Binding FilterViolation}" materialDesign:ShadowAssist.ShadowDepth="Depth0" BorderBrush="{x:Null}">
                    <materialDesign:PackIcon Kind="Search" Width="32" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"></materialDesign:PackIcon>
                </Button>
                <ComboBox Name="filterSearchbytypplate" Width="100" Height="30" BorderThickness="1" 
                  ItemsSource="{Binding GridPlateType}"
                  SelectedItem="{Binding SelectedPlateType}" 
               Padding="10,10,0,0" Background="White" Margin="0,9,5,9" FontSize="14" FontFamily="Tajawal" >

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Plate_type_name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="نوع اللوحة" Margin="10 0 5 0" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Tajawal" FontSize="14" FontWeight="Bold"/>
                <ComboBox Name="filterSearchbycode" Width="100" Height="30" BorderThickness="1" 
                  ItemsSource="{Binding GridProvinces}"
                  SelectedItem="{Binding SelectedProvinces}"
               Padding="10,10,0,0" Background="White" Margin="0,9,5,9" FontSize="14" FontFamily="Tajawal" SelectionChanged="filterSearchbycode_SelectionChanged" >

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Province_id}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="رمز المحافظه" Margin="20 0 5 0" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Tajawal" FontSize="14" FontWeight="Bold"/>

                <Button  x:Name="But_Delete_Violation" Command="{Binding Deletecommand}"
                     Height="40" Uid="7"   Padding="4,2" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="230,0,0,0" Width="70" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">حذف</TextBlock>
                        <materialDesign:PackIcon Kind="Delete" Margin="5 0 0 0" Width="20" Height="24" />
                    </StackPanel>
                </Button>
                <Button  x:Name="But_Edit_Violation" Command="{Binding Editcommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0" Width="70" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">تعديل</TextBlock>
                        <materialDesign:PackIcon Kind="Edit" Margin="5 0 0 0" Width="20" Height="24" />
                    </StackPanel>
                </Button>
                <Button  x:Name="But_Add_Violation" Command="{Binding Addcommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0" Width="70" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">إضافة</TextBlock>
                        <materialDesign:PackIcon Kind="Add" Margin="5 0 0 0" Width="20" Height="24" />
                    </StackPanel>   
                </Button>

            </StackPanel>

        </Border>
        <StackPanel  Background="White" >

            <DataGrid x:Name="GriddataViolation"  Style="{StaticResource Style_Datagrid}" Margin="10 5 40 5" ItemsSource="{Binding Grid_Violation}"  SelectedItem="{Binding Current_Violation,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                          materialDesign:DataGridAssist.CellPadding="1 5 8 8" materialDesign:DataGridAssist.ColumnHeaderPadding="8" MaxWidth="1400" HorizontalAlignment="Right"
                       Height="480" Width="1194"  >

                <DataGrid.Columns>

                    <DataGridTextColumn Binding="{Binding VounchrNum}"
                                        Header="رقم القسيمة" MinWidth="100" 
                                         />

                    <!-- set a max length to get an indicator in the editor -->
                    <DataGridTextColumn Binding="{Binding Violation_date}"
                                                           Header="التاريخ"
                                                       MinWidth="80"
                                                           
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <DataGridTextColumn Binding="{Binding Plate_Num}"
                                                           Header="رقم اللوحة"  MinWidth="80"
                                                          
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <DataGridTextColumn Binding="{Binding Plate_Type}"
                                                           Header="نوع اللوحة"  MinWidth="80"
                                                          
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <DataGridTextColumn Binding="{Binding Provinceid}"
                                                           Header="رمز المحافظة"  MinWidth="80"
                                                          
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <DataGridTextColumn Binding="{Binding String_ViolationType}"
                                                        Header="نوع المخالفة" MinWidth="300"
                                                        
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}">

                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Amount}"
                                                           Header="المبلغ"  MinWidth="80"
                                                            
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <!--<materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="المحافظة" MinWidth="80"
                                                           MaxLength="255" 
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <materialDesign:DataGridTextColumn Binding="{Binding Description}"
                                                           Header="المديرية"  MinWidth="80"
                                                           MaxLength="255" 
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />-->
                    <DataGridTextColumn Binding="{Binding String_Street}"
                                                           Header="مكان المخالفة"  MinWidth="80"
                                                          
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                    <!--<DataGridTextColumn Binding="{Binding String_TrafficMan}"
                                                           Header="بواسطة"  MinWidth="80"
                                                          
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />-->

                    <DataGridTextColumn Binding="{Binding Notise}"
                                                        Header="ملاحظة" MinWidth="100"
                                                        
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}">


                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding String_Status}"
                                                        Header="حالة السداد" MinWidth="10"
                                                        
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}">


                    </DataGridTextColumn>

                    <!-- use custom combo box column to get better combos. Use ItemsSourceBinding as your binding template to be applied to each combo -->

                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</UserControl>
