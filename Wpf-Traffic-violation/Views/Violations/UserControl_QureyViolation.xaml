                    <StackPanel  DockPanel.Dock="Top" Grid.Column="1"  >
                        <DataGrid Name="dataGrid" Margin="0,10,10,10" Style="{StaticResource Style_Datagrid}" IsReadOnly="False"
                              ItemsSource="{Binding Grid_Violation}" 
                              SelectedItem="{Binding Currunt_Violation}" 
                              materialDesign:DataGridAssist.CellPadding="1 5 8 8" 
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8" 
                              RowDetailsVisibilityMode="VisibleWhenSelected"
                        Height="355" RenderTransformOrigin="0.496,0.654"  >
                            <DataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <EventSetter Event="Selected" Handler="DataGridCell_Selected"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Resources>

                            </DataGrid.Resources>
                            <DataGrid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform AngleX="-0.472"/>
                                    <RotateTransform/>
                                    <TranslateTransform X="-1.884"/>
                                </TransformGroup>
                            </DataGrid.RenderTransform>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn  Binding="{Binding Isselected , UpdateSourceTrigger=PropertyChanged}" x:Name="selectedviolation"
                                                    
                                                ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                                EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}">
                                   
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Binding="{Binding VounchrNum}"
                                        Header="رقم القسيمة" MinWidth="80"
                                         />
                                <!--if you want to use the pop up style (MaterialDesignDataGridTextColumnPopupEditingStyle), you must use MaterialDataGridTextColumn-->
                                <materialDesign:DataGridTextColumn Binding="{Binding Plate_Num}"
                                                           Header="رقم اللوحة"  MinWidth="80"
                                                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}" 
                                                           />
                                <materialDesign:DataGridTextColumn Binding="{Binding Violation_date}"
                                                           Header="تاريخ المخالفة"  MinWidth="100"
                                                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}" 
                                                           />
                                <!-- set a max length to get an indicator in the editor -->

                                <materialDesign:DataGridTextColumn Binding="{Binding String_ViolationType}"
                                                        Header="نوع المخالفة"  MinWidth="150"
                                                        
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}">

                                </materialDesign:DataGridTextColumn>
                                <materialDesign:DataGridTextColumn Binding="{Binding String_Street}"
                                                           Header="المكان "  MinWidth="80"
                                                          
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />

                                <materialDesign:DataGridTextColumn Binding="{Binding Violation_penalty}"
