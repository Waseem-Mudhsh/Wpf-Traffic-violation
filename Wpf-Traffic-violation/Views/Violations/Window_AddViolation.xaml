<Window x:Class="Wpf_Traffic_violation.Views.Window_AddViolation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
    
        mc:Ignorable="d"
        Title="Window_AddViolation" Height="358" Width="1200" FlowDirection="RightToLeft" BorderThickness="1" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" BorderBrush="#FFDD2C00" WindowStyle="None" ScrollViewer.VerticalScrollBarVisibility="Disabled"  ResizeMode="NoResize">
    <DockPanel Background="WhiteSmoke" Height="358" Width="1200" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <!--/////////////////////////////////////////Top/////////////////////////////////////////////////-->
        <materialDesign:ColorZone DockPanel.Dock="Top" Background="OrangeRed">
            <StackPanel Orientation="Horizontal" Height="30" >

                <materialDesign:PackIcon Kind="Add" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="6 0 0 0"></materialDesign:PackIcon>
                <TextBlock Text="بيانات مخالفة" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Tajawal" FontWeight="Bold" Foreground="White"/>
                <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" HorizontalAlignment="Right" x:Name="But_close"  Width="30" Height="30" Foreground="Wheat" Background="{x:Null}" BorderBrush="{x:Null}"  Click="But_close_Click" Margin="1050,0,0,0" >
                    <materialDesign:PackIcon  Kind="Close" Width="24" Height="24" VerticalAlignment="Bottom"    />
                </Button>
            </StackPanel>
        </materialDesign:ColorZone>
        <!--///////////////////////////////////////////Bottom///////////////////////////////////////////////-->

        <Grid DockPanel.Dock="Bottom" Height="40">
            <Button Name="buttnsave" Command="{Binding Savecommand}" Content=" حفــظ"></Button>
        </Grid>
        <!--/////////////////////////////////////////////Center/////////////////////////////////////////////-->
        <Grid FlowDirection="RightToLeft" >

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Tajawal"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Foreground" Value="#022551"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="793*"/>
                <ColumnDefinition Width="407*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="رقم القسيمة :" Margin="15 0 030 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox    x:Name="textBox"   Height="40" Width="240" Text="{Binding Current_Violation.VounchrNum}"
                        materialDesign:HintAssist.Hint="رقم القسيمة..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,9" FontFamily="Tajawal" FontSize="14" />
                <TextBlock Text="الوقت :" Margin="25 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->
                <materialDesign:TimePicker SelectedTime="{x:Static sys:DateTime.Now}"     Width="240" Height="40" Background="White" FontFamily="Tajawal" FontSize="16" BorderThickness=" 0 0 0 1" Padding="03,0,03,4" />
                <TextBlock Text="التاريخ:" Margin="35 0 30 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <DatePicker SelectedDate="{x:Static sys:DateTime.Now}" Text="{Binding Current_Violation.Violation_date,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,ValidatesOnDataErrors=True}"   Width="240" Height="40" Background="White" FontFamily="Tajawal" FontSize="16" BorderThickness="1" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="  رقم اللوحة :" Margin="5 0 40 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <TextBox    x:Name="a"  Width="185" Text="{Binding Current_Violation.Plate_Num}"
                        materialDesign:HintAssist.Hint="رقم اللوحة..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White"  Margin="0 9 12 9" FontFamily="Tajawal" FontSize="14" />
                <!--<controls:AutoCompleteBox Name="a"  Width="185" ItemsSource="{Binding Grid_Plate}" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="20 8 0 5"
                                              ValueMemberPath="Plate_num" 
                                              SelectedItem="{Binding Selected_Plate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding Selected_Plate.Plate_num}" FilterMode="Contains" Margin="0 9 12 9"
                                             
                                          />-->
                <!--<controls:AutoCompleteBox Name="b"  ItemsSource="{Binding grid_plateDetails}" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="20 8 0 5" 
                                              ValueMemberPath="Province_id" 
                                              SelectedItem="{Binding Selected_Plates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding Selected_Plates.Province_id}" FilterMode="Contains" Margin="0 9" RenderTransformOrigin="0.5,0.5" Width="11"
                                             
                                          />-->
                <ComboBox Name="selectProvince" Width="300" Height="40" BorderThickness="1"
                  ItemsSource="{Binding GridProvinces}"
                  SelectedItem="{Binding SelectedProvinces, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 
              Padding="10,10,0,0" Background="White" Margin="0,9,5,9" FontSize="14" FontFamily="Tajawal" >
                    <!-- Optional: You can customize the appearance of each item in the ComboBox -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Province_id}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <TextBlock Text="نوع اللوحة :" Margin="20 0 28 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <ComboBox Name="viol_type" Width="300" Height="40" BorderThickness="1"
                  ItemsSource="{Binding GridPlateType}"
                  SelectedItem="{Binding SelectedPlateType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
               Padding="10,10,0,0" Background="White" Margin="0,9,5,9" FontSize="14" FontFamily="Tajawal" >
               
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Plate_type_name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
           
            </StackPanel>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" Grid.ColumnSpan="2">
              
                <TextBlock Text="نوع المخالفة :" Margin="15 0 030 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>

           <ComboBox Name="MultiSelectCombobox" Width="317" Height="40" BorderThickness="1 1 1 1" ItemsSource="{Binding Grid_ViolationType}"
                           SelectedItem="{Binding Selected_ViolationType,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" DisplayMemberPath="{Binding Violation_type_name}" 
                          Padding="10,10,0,0" Background="White" Margin="0,9,5,9" FontSize="14" FontFamily="Tajawal" >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Name="ComboBox_Provinces" >
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}النوع: {0}, المبلغ: {1}">
                                        <Binding Path="Violation_type_name" />
                                        <Binding Path="Maximum_price" />
                                    </MultiBinding>
                                </TextBlock.Text>
                              
                                       </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>
           

            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="المكان  :" Margin="18 0 27 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>

                <controls:AutoCompleteBox Name="street"  Width="240" ItemsSource="{Binding Grid_Streets}" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="20 8 0 5" 
                                              ValueMemberPath="Street_name" 
                                              SelectedItem="{Binding Selected_Street, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding Selected_Street.Street_name,ValidatesOnDataErrors=True}" FilterMode="Contains" Margin="0 9"
                                             
                                          />
                <TextBlock Text="بواسطة :" Margin="25 0 24 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>
                <controls:AutoCompleteBox Name="trafficman"  Width="240" ItemsSource="{Binding Grid_TrafficMan}" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="20 8 0 5" 
                                              ValueMemberPath="Traffic_man_name" 
                                              SelectedItem="{Binding Selected_TrafficMan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding Selected_TrafficMan.Traffic_man_name}" FilterMode="Contains" Margin="0 9"
                                             
                                          />
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->

            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Grid.ColumnSpan="2">
                <TextBlock Text="ملاحظة  :" Margin="18 0 25 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="99"/>

                <TextBox      Height="40" Width="628" Text="{Binding Current_Violation.Notise}"
                        materialDesign:HintAssist.Hint="الملاحظة..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="3 9 0 9" FontFamily="Tajawal" FontSize="14" />
                <!--<ComboBox  x:Name="FilledComboBox"
                          IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledComboBoxEnabledComboBox}"
                          materialDesign:HintAssist.Hint="نوع الهوية ..." Padding="10,10,0,0" Background="White"
                          Width="256"  Height="40" IsEditable="True" Margin="10 0 10 0" >
                    <ComboBoxItem Content="Item 1"/>
                    <ComboBoxItem Content="Item 2"   />
                    <ComboBoxItem Content="Item 3"   />
                </ComboBox>-->

            </StackPanel>
            <Border  BorderThickness="2" BorderBrush="LightBlue"  Grid.RowSpan="3" Grid.Column="1" Background="White" Height="100" Margin="145,6,143,10" Grid.Row="3" >
                <StackPanel  >
                    <Image x:Name="logo1" Source="{Binding Image1,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Stretch="Fill"/>
                </StackPanel>
            </Border>
            <Border  Margin="265 0 0 2" BorderThickness="2" BorderBrush="LightBlue" materialDesign:ShadowAssist.ShadowDepth="Depth2" Grid.RowSpan="3" Grid.Column="1" Background="White" Height="100" Width="116" Grid.Row="3" >
                <StackPanel  >
                    <Image x:Name="logo2" Source="{Binding Image2,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Stretch="Fill"/>
                </StackPanel>
            </Border>

        </Grid>
        <!--نستحدم الفريم هذا أذا كنا نشتي نستخدم يوزركنترول-->
        <!--<Frame x:Name="Frame_Window" NavigationUIVisibility="Hidden" Width="1300" Height="270"></Frame>-->
    </DockPanel>
</Window>
