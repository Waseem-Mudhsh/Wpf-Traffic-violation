                <TextBlock Text="نوع اللوحة" Margin="10 0 5 0" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Tajawal" FontSize="14" FontWeight="Bold"/>
                    <!--<ComboBox Name="filterSearchbytypplate" Width="100" Height="30" BorderThickness="1" ItemsSource="{Binding GridPlateType}" SelectedItem="{Binding SelectedPlateType}" Padding="10,10,0,0"
                          Background="White" Margin="0,9,5,9" FontSize="14" FontFamily="Tajawal" Foreground="Black">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Plate_type_name}" Foreground="Black"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="LightBlue"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="White"/>
                        </ComboBox.Resources>
                    </ComboBox>-->
                <controls:AutoCompleteBox Name="filterSearchbytypplate"   Width="100" Height="35" ItemsSource="{Binding GridPlateType}"  Foreground="Black" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14"  Padding="10,10,0,0"
                                              ValueMemberPath="Plate_type_name" 
                                              SelectedItem="{Binding SelectedPlateType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedPlateType.Plate_type_name,ValidatesOnDataErrors=True}" FilterMode="Contains" Margin="0 9"
                                             
                                          />



                <TextBlock Text="رمز المحافظه" Margin="20 0 5 0" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Tajawal" FontSize="14" FontWeight="Bold"/>

             
                <controls:AutoCompleteBox Name="filterSearchbycode"   Width="100" Height="35"  ItemsSource="{Binding GridProvinces}" Foreground="Black"  Background="White"
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14"  Padding="10,10,0,0"
                                              ValueMemberPath="Province_id" 
                                              SelectedItem="{Binding SelectedProvinces, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedProvinces.Province_id,ValidatesOnDataErrors=True}" FilterMode="Contains" Margin="0 9"
                                             
                                          />
                <Button Width="40" Height="40" Padding="0" Command="{Binding Showcommand}" Name="searchBT1" Click="Button_Click" Background="OrangeRed" materialDesign:ShadowAssist.ShadowDepth="Depth1" >
                    <materialDesign:PackIcon Kind="Search" Foreground="White"  Width="24" Height="24" HorizontalAlignment="Center" />
                </Button>
                <Button Name="butn_Query" Height="40" Width="100" Margin="40 0 10 0" Command="{Binding ShowDetaileForViolation}"  Padding="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <materialDesign:PackIcon Kind="AttachMoney" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Text="استعلام" VerticalAlignment="Center" FontFamily="Tajawal" FontSize="18" Padding="5 2 0 2"/>
                    </StackPanel>
                </Button>
                
                <!--<TextBlock Text="رقم القسيمة:" Margin="30 0 10 0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="90" FontFamily="Tajawal" FontSize="14" FontWeight="Bold"/>
                <TextBox    Name="viol_type"  Height="40" Width="240" Text="{Binding Current_Violation.Violation_id}"
                        materialDesign:HintAssist.Hint="رقم القسيمة..."
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="5" FontFamily="Tajawal" FontSize="14" />

                <Button Width="40" Height="40" Padding="0" Command="{Binding Showcommand}" Name="searchBT2" Click="Button_Click" Background="OrangeRed" materialDesign:ShadowAssist.ShadowDepth="Depth1" >
                    <materialDesign:PackIcon Kind="Search" Foreground="White"  Width="24" Height="24" HorizontalAlignment="Center" />
                </Button>-->
            </StackPanel>
        </Border>
        <Grid Background="#f5f5f5">
            <Grid.ColumnDefinitions>
