    <StackPanel Orientation="Horizontal">
        <Button  Height="50" VerticalAlignment="Top"   Background="{x:Null}" Foreground="{x:Null}" BorderBrush="{x:Null}"  Style="{StaticResource MaterialDesignFlatButton}" >
        <materialDesign:PackIcon Kind="{Binding Path=Icon}" Width="24" Height="24"   Foreground="White" Margin="3 0" />
    </Button>
    <DockPanel  >
        
        <ListBoxItem x:Name="ListViewItemMenu" DockPanel.Dock="Left" Content="{Binding Path=Header}" FontSize="14"  Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Stretch" FontFamily="Tajawal" />
        <Expander x:Name="ExpanerMenu" Header="{Binding Path=Header}" HorizontalAlignment="Stretch" IsExpanded="False" Width="150"  Background="{x:Null}" Foreground="White">
            <ListView x:Name="ListViewMenu" ItemsSource="{Binding Path=SubItems}" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"  HorizontalAlignment="Left"  SelectionChanged="ListViewMenu_SelectionChanged" Background="Black">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=Name}" FontFamily="Tajawal" HorizontalAlignment="Right" />


                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </Expander>
    </DockPanel>
    </StackPanel>
