<UserControl x:Class="Wpf_Traffic_violation.Views.Reservation.PaidReservation"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ViewModel="clr-namespace:Wpf_Traffic_violation.ViewModel"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Traffic_violation.Views"
             xmlns:permission="clr-namespace:Wpf_Traffic_violation.Core.helper"
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
        mc:Ignorable="d"
        >
    <UserControl.DataContext>
        <ViewModel:Reservation_ViewModel/>
    </UserControl.DataContext>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderThickness="0 0 0 1" BorderBrush="Blue" Background="White" Width="1026">
            <StackPanel  Height="60"  Orientation="Horizontal" HorizontalAlignment="Center">
                <!--top-->
                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="30 0" FlowDirection="RightToLeft" >


                </StackPanel>
                <Button  Command="{Binding Excelcommand}"
                                   Height="40"       Uid="7"  x:Name="but1" Padding="0" Background="#FF097221" BorderBrush="{x:Null}" Width="80" >
                    <StackPanel Orientation="Horizontal" Margin="12 0 12 0" HorizontalAlignment="Center">
                        <TextBlock  VerticalAlignment="Center"><Run Text="تسديد"/></TextBlock>
                        <!--<materialDesign:PackIcon Kind="FileExcel" Margin="8 0 0 0" Width="24" Height="24" HorizontalAlignment="Right" />-->
                    </StackPanel>
                </Button>
                <!--<Button  Height="40" Width="40" Padding="0" Background="OrangeRed" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Command="{Binding FilterViolationwithrecpt}" materialDesign:ShadowAssist.ShadowDepth="Depth0" BorderBrush="{x:Null}">
                    <materialDesign:PackIcon Kind="Search" Width="32" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"></materialDesign:PackIcon>
                </Button>
                <TextBox    x:Name="textBoxrecpt" Width="100" Height="35" Text="{Binding Selectedreceptid}" 
                        materialDesign:HintAssist.Hint="" 
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,5" FontFamily="Tajawal" FontSize="14" 
                            >



                </TextBox>
                <TextBlock Text="رقم السند" Margin="10 0 5 0" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Tajawal" FontSize="14" FontWeight="Bold"/>-->

                <StackPanel  Height="60"  Orientation="Horizontal" Width="615">
                    <!--top-->
                    <StackPanel  Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Margin="30 0" FlowDirection="RightToLeft" >
                        <!--<controls:AutoCompleteBox Width="200" ItemsSource="{Binding Grid_Violation }" 
                                              ItemTemplate="{StaticResource AutoId}" 
                                              FontSize="14" Padding="10 8 0 5" 
                                              ValueMemberPath="Search" Margin="2 0"
                                              SelectedItem="{Binding Current_Violation , Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" FilterMode="Contains"
                                              />
                    <Button  Height="40" Width="40" Padding="0" Background="OrangeRed" VerticalAlignment="Center" HorizontalAlignment="Center"
                           materialDesign:ShadowAssist.ShadowDepth="Depth0" BorderBrush="{x:Null}">
                        <materialDesign:PackIcon Kind="Search" Width="32" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"></materialDesign:PackIcon>
                    </Button>-->

                    </StackPanel>

                    <Button  Height="40" Width="40" Padding="0" Background="OrangeRed" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Command="{Binding FilterViolationwithrecpt}" materialDesign:ShadowAssist.ShadowDepth="Depth0" BorderBrush="{x:Null}">
                        <materialDesign:PackIcon Kind="Search" Width="32" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"></materialDesign:PackIcon>
                    </Button>
                    <TextBox    x:Name="textsearch" Width="100" Height="35" Text="{Binding Selectedreceptid}" 
                        materialDesign:HintAssist.Hint=""  BorderBrush="SaddleBrown"
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="10,5" FontFamily="Tajawal" FontSize="14" 
                            >



                    </TextBox>
                    <TextBlock Text="نوع اللوحه" Margin="10 0 5 0" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Tajawal" FontSize="14" FontWeight="Bold"/>
                    <TextBox    x:Name="texttypenumber" Width="100" Height="35" Text="{Binding Selectedreceptid}" 
                        materialDesign:HintAssist.Hint=""  BorderBrush="SaddleBrown"
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,5" FontFamily="Tajawal" FontSize="14" 
                            >



                    </TextBox>
                    <TextBlock Text="رقم اللوحه" Margin="10 0 5 0" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Tajawal" FontSize="14" FontWeight="Bold"/>

                    <TextBox    x:Name="textNumber" Width="100" Height="35" Text="{Binding Selectedreceptid}" 
                        materialDesign:HintAssist.Hint="" BorderBrush="SaddleBrown"  
                         BorderThickness="1,1,1,1" Padding="5,3,0,0"  UseLayoutRounding="False" Background="White" Margin="0,5" FontFamily="Tajawal" FontSize="14" 
                            >



                    </TextBox>
                    <TextBlock Text="رقم القعادة" Margin="10 0 5 0" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Tajawal" FontSize="14" FontWeight="Bold"/>
                    <!--<Button  x:Name="But_Edit_Violation" Command="{Binding Editcommand}"
                     Height="40" Uid="7"   Padding="4,2" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0" Width="70" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  VerticalAlignment="Center" Margin="0 0 0 0">تعديل</TextBlock>
                        <materialDesign:PackIcon Kind="Edit" Margin="5 0 0 0" Width="20" Height="24" />
                    </StackPanel>
                </Button>-->

                </StackPanel>
              
            </StackPanel>

        </Border>
        <StackPanel x:Name="trkSetWidthAdjust"  Margin="20 20 20 20" Background="White" Height="auto" Width="auto">
            <Grid Name="TrkAnalysisDataGrid"  >
                <!--<Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Background="White"  Height="auto"  Margin="152,0,0,0" Grid.Column="1">
                    <DataGrid  x:Name="GriddataViolation"
                           Style="{StaticResource Style_Datagrid}"
                           ItemsSource="{Binding Local_CollectionViolation}"  
                          SelectedItem="{Binding Current_Violation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="510" Width="auto" 
                           >

                        <DataGrid.Columns>
                            <!--<DataGridTemplateColumn Header="رقم" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataContext.RowNumber, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>-->

                            <DataGridTextColumn  Binding="{Binding VounchrNum}"
                                        Header="اسم السائق" MinWidth="100" 
                                         />

                            <!-- use custom combo box column to get better combos. Use ItemsSourceBinding as your binding template to be applied to each combo -->
                            <!-- set a max length to get an indicator in the editor -->
                            <DataGridTextColumn   Binding="{Binding Violation_date}"
                                                           Header="رقم المركبة"
                                                       MinWidth="80"
                                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                            <DataGridTextColumn   Binding="{Binding Plate_Num}"
                                                           Header="نوع الرقم"  MinWidth="50"
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                            <DataGridTextColumn   Binding="{Binding Plate_Type}"
                                                           Header="نوع المركبة"  MinWidth="50"
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                            <DataGridTextColumn   Binding="{Binding Provinceid}"
                                                           Header="سبب الحجز"  MinWidth="20" Width="auto"
                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"  />
                            <DataGridTextColumn Binding="{Binding String_ViolationType}"
                                                        Header="تاريح الحجز" MinWidth="50"
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"/>

                            <DataGridTextColumn   Binding="{Binding Notise}"
                                                        Header="تايخ الدخول" MinWidth="80"
                                                        
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"/>
                            <DataGridTextColumn   Binding="{Binding Notise}"
                                                        Header="جهة الحجز" MinWidth="80"
                                                        
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"/>
                            <DataGridTextColumn   Binding="{Binding Notise}"
                                                        Header="رقم القعادة" MinWidth="80"
                                                        
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"/>
                            <DataGridTextColumn   Binding="{Binding Notise}"
                                                        Header="الملاحظة" MinWidth="80"
                                                        
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"/>

                        </DataGrid.Columns>


                    </DataGrid>

                </StackPanel>

            </Grid>
        </StackPanel>


    </DockPanel>
</UserControl>
